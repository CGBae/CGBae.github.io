---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
import { projects } from '@/data/projects';
import { withBase } from '@/utils/paths';
---

<BaseLayout
  title="About — Bae Cheolgyu"
  description="사람의 의도와 로봇의 움직임을 소프트웨어로 연결하는 신입 개발자 배철규입니다. 사람이 쉽게 다루고 현장에서 믿고 사용할 수 있는 로봇을 만들고자 합니다."
>
  <section class="about-hero page-shell">
    <div class="about-hero__profile">
      <div class="about-hero__portrait-frame">
        <img class="about-hero__portrait"
          src={withBase('/images/profile/bae-cheolgyu.jpg')}
          width="177" height="236" alt="배철규 프로필 사진"
          decoding="async" fetchpriority="high" />
      </div>
      <div class="about-hero__identity">
        <p class="eyebrow">About me</p>
        <p class="about-hero__name">배철규</p>
        <p class="about-hero__role">신입 로봇 소프트웨어 개발자</p>
      </div>
    </div>
    <div class="about-hero__copy">
      <h1>Building<br />robot behavior.</h1>
      <div class="about-hero__intro">
        <p class="about-hero__lead">
          사람의 의도와 로봇의 움직임을 소프트웨어로 연결하는 신입 개발자 배철규입니다.
        </p>
        <p>
          문제를 작은 단위로 나누고 데이터 흐름과 실제 동작을 확인하며 해결책을 찾는 개발을 지향합니다.
          새로운 기술을 익히고 배운 내용을 팀과 공유하며, 함께 문제를 해결하는 동료가 되고 싶습니다.
        </p>
        <p>
          인지·제어·인터페이스를 함께 이해하는 개발자로 성장해,
          사람이 쉽게 다루고 현장에서 믿고 사용할 수 있는 로봇을 만드는 것이 목표입니다.
        </p>
      </div>
    </div>
  </section>

  <div class="about-sections page-shell">
    <section class="about-section" aria-labelledby="experience-title">
      <h2 id="experience-title">Project experience</h2>
      <ul class="about-projects">
        {projects.map((project) => (
          <li>
            <a class="text-link" href={withBase('/projects/' + project.slug + '/')}>
              {project.shortTitle} <span aria-hidden="true">↗</span>
            </a>
            <p>{project.role}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-section" aria-labelledby="technology-title">
      <h2 id="technology-title">Technical areas</h2>
      <ul class="about-list">
        <li>
          <strong>Programming</strong>
          <span>Python · C/C++ · Java</span>
        </li>
        <li>
          <strong>Robotics</strong>
          <span>ROS2 인터페이스 통합 · Nav2 · Isaac Sim</span>
        </li>
        <li>
          <strong>Vision</strong>
          <span>OpenCV · ArUco 마커 기반 위치 지정 · VLM 조립 검증</span>
        </li>
        <li>
          <strong>Control / Interface</strong>
          <span>Waypoint 경로 생성 · 웹 티칭펜던트 · 연속 동작 구현</span>
        </li>
        <li>
          <strong>Collaboration</strong>
          <span>Git / GitHub · 모듈 연동 · 실기기 통합 검증</span>
        </li>
      </ul>
    </section>

    <section class="about-section" aria-labelledby="education-title">
      <h2 id="education-title">Education</h2>
      <div class="about-entries">
        <div class="about-entry">
          <h3>서경대학교 소프트웨어학과</h3>
          <p>졸업 · 2020.03 — 2026.02</p>
        </div>
        <div class="about-entry">
          <h3>두산로보틱스 ROKEY 부트캠프</h3>
          <p>수료 · 2026.02.09 — 2026.08.12</p>
          <p class="about-section__note">ROS2 기반 이동 로봇·협동로봇·시뮬레이션 팀 프로젝트 수행</p>
        </div>
      </div>
    </section>

    <section class="about-section" id="resume" aria-labelledby="resume-title">
      <h2 id="resume-title">Resume</h2>
      <div class="about-entry">
        <p>신입 로봇 소프트웨어 개발자 이력서 · PDF 1페이지</p>
        <div class="about-resume-links">
          <a class="text-link" href={withBase(site.resumePath)} target="_blank" rel="noopener">
            이력서 PDF 열기 ↗<span class="sr-only"> (새 창)</span>
          </a>
          <a class="text-link" href={withBase(site.resumePath)} download="배철규_이력서.pdf">
            PDF 다운로드 <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </section>

    <section class="about-section" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <div class="about-contact">
        <p>Email · <a href={'mailto:' + site.email}>{site.email}</a></p>
        <p>Phone · <a href={site.phoneHref}>{site.phone}</a></p>
        <p>
          GitHub · <a href={site.githubUrl} target="_blank" rel="noreferrer">
            {site.githubLabel}<span class="sr-only"> (새 창)</span>
          </a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-hero {
    grid-template-columns: minmax(225px, 0.28fr) minmax(0, 0.72fr);
    gap: clamp(3rem, 7vw, 6rem);
    align-items: stretch;
    padding-block: clamp(4rem, 8vw, 6rem);
  }
  .about-hero__profile {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1.25rem;
    min-width: 0;
  }
  .about-hero__portrait-frame {
    display: grid;
    place-items: center;
    min-width: 0;
    padding: 1.25rem;
    border: var(--rule);
  }
  /* Preserve the supplied photo's resolution and keep it inside its padded frame. */
  .about-hero__portrait { width: 177px; max-width: 100%; height: auto; }
  .about-hero__identity { display: grid; gap: 0.45rem; min-width: 0; }
  .about-hero__name { font-size: 1.7rem; font-weight: 700; letter-spacing: -0.04em; }
  .about-hero__role { max-width: 15rem; color: var(--muted); font-size: 0.86rem; word-break: keep-all; overflow-wrap: anywhere; }
  .about-hero__copy { display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
  .about-hero h1 {
    max-width: 10em;
    margin-top: 0;
    font-size: clamp(3.5rem, 6.2vw, 5.6rem);
    line-height: 0.98;
  }
  .about-hero__intro {
    display: grid;
    align-self: stretch;
    gap: 1.15rem;
    max-width: 42rem;
    margin-top: 2rem;
    font-size: 1.02rem;
    line-height: 1.85;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .about-hero__intro > p { color: var(--muted); }
  .about-hero__intro > .about-hero__lead { color: var(--ink); font-size: 1.16rem; }
  @media (max-width: 960px) {
    .about-hero { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    .about-hero__profile { grid-template-columns: minmax(0, 225px) minmax(0, 1fr); grid-template-rows: auto; align-items: center; }
  }
  @media (max-width: 760px) {
    .about-hero { padding-block: 3rem 4rem; }
    .about-hero__profile { grid-template-columns: minmax(0, 168px) minmax(0, 1fr); gap: 1.2rem; }
    .about-hero__portrait-frame { padding: 12px; }
    .about-hero__name { font-size: 1.5rem; }
    .about-hero__role { font-size: 0.8rem; }
    .about-hero h1 { font-size: clamp(2.5rem, 10vw, 4rem); }
    .about-hero__intro { margin-top: 1.5rem; font-size: 0.98rem; }
    .about-hero__intro > .about-hero__lead { font-size: 1.1rem; }
  }
  .about-projects {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about-projects li + li { padding-top: 1.5rem; border-top: var(--rule); }
  .about-projects p { margin-top: 0.75rem; color: var(--muted); }
  .about-entries { display: grid; gap: 2rem; }
  .about-entry { display: grid; align-content: start; gap: 0.5rem; }
  .about-entry h3 { font-size: 1.05rem; font-weight: 700; }
  .about-resume-links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 0.65rem; }
  .about-contact a { overflow-wrap: anywhere; }
</style>
