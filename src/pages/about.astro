---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
import { withBase } from '@/utils/paths';
---

<BaseLayout
  title="About — Bae Cheolgyu"
  description="Bae Cheolgyu의 관심 분야, 기술 영역과 연락처를 정리한 페이지."
>
  <section class="about-hero page-shell">
    <div>
      <p class="eyebrow">About / Profile draft</p>
      <h1>Building<br />robot behavior.</h1>
    </div>
    <p class="about-hero__intro">
      Perception, navigation, manipulation, and AI를 실제 로봇 동작으로 연결하는
      소프트웨어를 개발합니다. 프로젝트의 문제 정의와 구현 근거는 각 프로젝트 분석
      문서가 준비되는 대로 구체화합니다.
    </p>
  </section>

  <div class="about-sections page-shell">
    <section class="about-section" aria-labelledby="interest-title">
      <h2 id="interest-title">Interests</h2>
      <div>
        <p>
          인지 결과가 좌표, 경로, 로봇팔 동작 또는 작업 지원으로 이어지는 전체 연결
          과정에 관심이 있습니다.
        </p>
        <p class="about-section__note">[프로젝트 분석 후 구체화]</p>
      </div>
    </section>

    <section class="about-section" aria-labelledby="technology-title">
      <h2 id="technology-title">Technical areas</h2>
      <ul class="about-list">
        <li>
          <strong>Robotics</strong>
          <span>ROS2 · TF2 · Nav2 · Isaac Sim</span>
        </li>
        <li>
          <strong>AI / Vision</strong>
          <span>ArUco · Pose Estimation · LLM</span>
        </li>
        <li>
          <strong>Control / Interface</strong>
          <span>Motion Planning · Teaching Pendant · Robot Control</span>
        </li>
      </ul>
    </section>

    <section class="about-section" aria-labelledby="education-title">
      <h2 id="education-title">Education</h2>
      <p class="placeholder-note">
        학력 정보 [사용자 확인 필요] — 실제 이력 확인 후 학교, 전공, 기간을 입력합니다.
      </p>
    </section>

    <section class="about-section" id="resume" aria-labelledby="resume-title">
      <h2 id="resume-title">Resume</h2>
      <div>
        {
          site.resumePath ? (
            <a class="text-link" href={withBase(site.resumePath)}>Resume PDF 열기 ↗</a>
          ) : (
            <p class="placeholder-note">
              Resume PDF [사용자 확인 필요] — 파일이 준비되면 `public/resume.pdf`에 추가합니다.
            </p>
          )
        }
      </div>
    </section>

    <section class="about-section" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <div class="about-contact">
        <p>
          GitHub · <a href={site.githubUrl} target="_blank" rel="noreferrer">{site.githubLabel}<span class="sr-only"> (새 창)</span></a>
        </p>
        <p>
          Email · {
            site.email ? (
              <a href={`mailto:${site.email}`}>{site.email}</a>
            ) : (
              <span>{site.emailLabel}</span>
            )
          }
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
