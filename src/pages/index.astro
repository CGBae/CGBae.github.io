---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import { projects } from '@/data/projects';
---

<BaseLayout bodyClass="home-page">
  <section class="home-intro page-shell" aria-labelledby="home-title">
    <p class="home-intro__label">Robot Software Engineer · Portfolio</p>
    <div class="home-intro__grid">
      <h1 id="home-title">
        Perception, navigation, manipulation, AI를<br />
        실제 로봇 동작으로 연결합니다.
      </h1>
    </div>
  </section>

  <section class="project-index" id="projects" aria-label="로봇 프로젝트 목록">
    <div class="page-shell project-index__list">
      {
        projects.map((project) => (
          <ProjectRow project={project} />
        ))
      }
    </div>
  </section>
</BaseLayout>
