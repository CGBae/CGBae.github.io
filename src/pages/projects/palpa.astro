---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectVideo from '@/components/ProjectVideo.astro';
import ProjectContribution from '@/components/ProjectContribution.astro';
import { projectBySlug } from '@/data/projects';
import { withBase } from '@/utils/paths';
import '@/styles/palpa.css';

const project = projectBySlug.palpa;
const asset = (file: string) => withBase('/projects/palpa/' + file);
const teachingSteps = [
  ['01', '자세 조정', 'J1–J6 관절 조그와 BASE 좌표 이동'],
  ['02', '작업점 저장', '현재 관절각에 이름·메모·역할 연결'],
  ['03', '다시 실행', '저장한 포인트를 호출해 이동 확인'],
];
const controlSteps = [
  ['01', '사용자 조작', '관절·BASE·저장 포인트 선택'],
  ['02', 'Teaching Pendant', 'HTML / JavaScript → HTTP GET'],
  ['03', 'HTTP Handler', '요청별 입력·상태 확인'],
  ['04', 'JogWorker', 'MoveJoint / MoveLine 서비스 호출'],
  ['05', 'Driver · M0609', '명령 실행, 관절·로봇 상태 반환'],
  ['06', '상태 snapshot', 'GET /api/status → 화면 갱신'],
];
const thresholds = [
  ['P5 허브', '45°', '허브 출입 구간'],
  ['일반 경유점', '25°', '기본 전환 기준'],
  ['폐기 복귀 P29', '4°', '해당 복귀 구간의 개별 설정'],
];
const diagrams = [
  ['palpa-motion-lead.svg', '잔여각 공식, 비동기 명령 전환 과정과 구간별 lead 설정을 설명한 도식', 950],
  ['palpa-motion-policy.svg', '각 점의 도착을 기다리는 순차 실행과 마지막 작업점에서 도착을 확인하는 체인 실행의 비교', 910],
];
const motionCode = [
  '# wait_lead + blend_chain의 핵심 흐름을 축약',
  'send_move_joint(via, sync_type=1, radius=0)',
  'while max(abs(via[j] - current[j]) for j in range(6)) > lead_deg:',
  '    current = read_joint_state()',
  'send_move_joint(next_target, sync_type=1, radius=0)',
  '# 마지막 작업점에서는 별도 도착·정지 확인',
].join('\n');
---

<BaseLayout title="PALPA · Human to Robot Motion — Bae Cheolgyu"
  description={project.description} bodyClass="project-page project-page--palpa">
  <section class="palpa-hero page-shell" id="demo" aria-labelledby="palpa-title">
    <header class="palpa-hero__copy">
      <p class="eyebrow">04 / PALPA · Human–Robot Control</p>
      <h1 id="palpa-title"><span>Human Input</span><span>to Robot Motion</span></h1>
      <div class="palpa-hero__intro">
        <p class="palpa-hero__subtitle">조작을 로봇의 움직임으로 연결하다</p>
        <p class="palpa-hero__lead">PALPA는 그리퍼의 힘·폭 정보를 이용해 공을 분류하고 주문에 맞춰 포장하는 협동로봇 시스템입니다. 웹에서 자세를 조정하고 작업점을 저장하는 과정부터, 다음 이동 명령을 보내는 시점을 조정한 구현까지 담았습니다.</p>
        <ul class="palpa-keywords" aria-label="핵심 기술">
          <li>Teaching Pendant</li><li>Waypoint</li><li>Motion Chaining</li><li>Python · ROS2</li>
        </ul>
      </div>
      <dl class="palpa-role">
        <div><dt>Team project</dt><dd>공 분류·주문 포장<br />4인 협동로봇 프로젝트</dd></div>
        <div><dt>Platform</dt><dd>Doosan M0609<br />OnRobot RG2 · ROS2</dd></div>
        <div><dt>Project period</dt><dd>{project.period}</dd></div>
      </dl>
    </header>
    <ProjectContribution role={project.role} />
    <figure class="palpa-evidence palpa-hero__demo">
      <ProjectVideo src={asset('palpa-demo.mp4')} poster={asset('palpa-demo-poster.webp')}
        captions={asset('palpa-demo.ko.vtt')} width={1280} height={800} autoplay={true}
        label="고객 주문, 로봇 작업 시작, 공 판별과 이송, 뚜껑 체결, 포장 완료를 보여주는 PALPA 팀 시연" />
      <figcaption><span>주문 → 공 분류 → 포장 · 31초 편집 요약</span><span>실제 장비 시연 · 무음 · 장면 설명 포함</span></figcaption>
    </figure>
    <div class="palpa-demo-footer">
      <p class="palpa-note">주요 장면을 연결한 영상으로, 31초는 한 주문의 처리 시간이 아닙니다. 첫 주문 화면은 고객용 웹이며 아래의 로봇 운용 콘솔과는 별도 화면입니다.</p>
      <div class="palpa-links">
        <a class="text-link" href="#teaching">티칭 화면 살펴보기 <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="#motion">이동 연결 방식 <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="palpa-section page-shell" id="question" aria-labelledby="question-title">
    <div class="palpa-section__header">
      <p class="palpa-label">01 / Engineering question</p>
      <div>
        <h2 id="question-title">웹에서 만든 조작을<br />연속된 로봇 이동으로</h2>
        <p>자세를 움직이는 화면에서 한 걸음 더 나아가, 작업점을 저장하고 구간을 반복 실행하며 이동 흐름을 조정할 수 있어야 했습니다. 조작·명령·피드백을 연결하고, 경유점과 최종 작업점에 서로 다른 전환 조건을 적용했습니다.</p>
      </div>
    </div>
    <ol class="palpa-inputs" aria-label="프로젝트의 세 가지 기술 초점">
      <li><span>I</span><strong>Teaching Pendant</strong><small>자세 조작과 waypoint 운용</small></li>
      <li><span>II</span><strong>Command &amp; Feedback</strong><small>웹 입력과 HTTP / ROS 명령 연결</small></li>
      <li><span>III</span><strong>Motion Chaining</strong><small>잔여 관절각에 따른 다음 목표 전환</small></li>
    </ol>
    <p class="palpa-note">아래 기술 설명은 웹 운용 인터페이스와 모션 제어를 연결한 팀 구현을 기준으로 합니다.</p>
  </section>

  <section class="palpa-section page-shell" id="teaching" aria-labelledby="teaching-title">
    <div class="palpa-section__header">
      <p class="palpa-label">02 / Teaching Pendant</p>
      <div>
        <h2 id="teaching-title">자세를 움직이고,<br />작업점으로 저장하다</h2>
        <p>관절별 조그와 BASE 좌표 이동으로 로봇 자세를 조정합니다. 현재 관절각에 이름·메모를 붙여 저장하고, 필요한 포인트를 다시 호출해 작업 경로를 구성합니다.</p>
      </div>
    </div>
    <div class="palpa-section__body">
      <figure class="palpa-evidence palpa-teaching-overview">
        <img src={asset('palpa-teaching.webp')} width="1416" height="1077" loading="lazy" decoding="async"
          alt="J1부터 J6까지 관절 조그, BASE 좌표 이동과 저장 포인트 목록을 함께 표시한 PALPA 티칭 탭" />
        <figcaption><span>티칭 탭 · 관절 / BASE / 저장 포인트</span><a href={asset('palpa-teaching.webp')} target="_blank" rel="noopener">화면 확대 ↗</a></figcaption>
      </figure>
      <div class="palpa-teaching-insets">
        <figure class="palpa-evidence">
          <img src={asset('palpa-teaching-jog.webp')} width="564" height="965" loading="lazy" decoding="async"
            alt="J1–J6 관절 슬라이더와 BASE 단계 이동 버튼을 확대한 실제 티칭 화면" />
          <figcaption><span>01 / 관절·BASE 자세 조정</span><a href={asset('palpa-teaching-jog.webp')} target="_blank" rel="noopener">확대 ↗</a></figcaption>
        </figure>
        <figure class="palpa-evidence">
          <img src={asset('palpa-teaching-waypoints.webp')} width="656" height="965" loading="lazy" decoding="async"
            alt="저장 포인트의 이름, 관절각, 그리퍼 폭, 역할과 이동 버튼이 보이는 목록 확대" />
          <figcaption><span>02 / 저장 포인트와 재실행</span><a href={asset('palpa-teaching-waypoints.webp')} target="_blank" rel="noopener">확대 ↗</a></figcaption>
        </figure>
      </div>
      <ol class="palpa-process" aria-label="작업점 티칭 과정">
        {teachingSteps.map(([number, title, note]) => (
          <li><span>{number}</span><strong>{title}</strong><small>{note}</small></li>
        ))}
      </ol>
      <p class="palpa-note">화면의 30개는 저장된 포인트 수입니다. 포인트는 JSON으로 보존하며, 좌표를 바꾸려면 새 자세를 저장합니다. 위 화면은 촬영된 운용 UI입니다.</p>
    </div>
  </section>

  <section class="palpa-section page-shell" id="command" aria-labelledby="command-title">
    <div class="palpa-section__header">
      <p class="palpa-label">03 / Command &amp; feedback</p>
      <div>
        <h2 id="command-title">웹 입력이<br />실제 로봇 명령이 되기까지</h2>
        <p>로컬 웹 화면의 입력은 Python HTTP 서버로 전달됩니다. 실행 워커는 요청에 따라 Doosan의 MoveJoint 또는 MoveLine 서비스를 호출하고, 관절값과 작업 상태는 다시 화면으로 돌아옵니다.</p>
      </div>
    </div>
    <ol class="palpa-control palpa-section__body" aria-label="로컬 조작에서 로봇 실행과 화면 갱신까지의 순서">
      {controlSteps.map(([number, title, note]) => (
        <li><span>{number}</span><strong>{title}</strong><small>{note}</small></li>
      ))}
    </ol>
    <p class="palpa-boundary">화면은 <strong>500ms 간격으로 상태를 요청</strong>합니다. JointState는 별도로 구독하지만, pose·힘 등 일부 서비스 값은 이동 중 갱신이 보류될 수 있습니다.</p>
    <details class="palpa-details">
      <summary>HTTP / ROS 명령과 상태 피드백 도해</summary>
      <div class="palpa-details__body">
        <figure class="palpa-evidence">
          <div class="palpa-diagram-scroll" role="region" aria-label="로컬 제어 도해, 작은 화면에서는 가로 스크롤" tabindex="0">
            <img src={asset('palpa-control-flow.svg')} width="1440" height="900" loading="lazy" decoding="async"
              alt="Teaching Pendant에서 HTTP Handler와 JogWorker를 거쳐 ROS2 로봇 명령을 실행하고 RobotMonitor의 상태를 화면에 반환하는 흐름" />
          </div>
          <figcaption><span>현재 코드에 근거한 로컬 제어 구조</span><a href={asset('palpa-control-flow.svg')} target="_blank" rel="noopener">도해 크게 보기 ↗</a></figcaption>
        </figure>
      </div>
    </details>
    <div class="palpa-split palpa-subsection">
      <div class="palpa-copy">
        <p class="palpa-label">Feedback on screen</p>
        <h3>작업 진행과 완료를<br />운용 화면에서 확인하다</h3>
        <p>관절과 그리퍼 상태, 현재 작업, 최근 명령의 상태를 화면에 모았습니다. 실행 요청 이후 공정이 어디까지 진행됐는지 확인하는 접점입니다.</p>
        <p class="palpa-note">작업 중·완료 화면을 서로 다른 시점에서 발췌했습니다. 클릭과 실제 동작의 응답 지연을 측정한 영상은 아닙니다.</p>
      </div>
      <figure class="palpa-evidence">
        <ProjectVideo src={asset('palpa-feedback.mp4')} poster={asset('palpa-feedback-poster.webp')}
          captions={asset('palpa-feedback.ko.vtt')} width={1160} height={956} loop={false}
          label="PALPA 운용 콘솔의 작업 진행과 완료 표시를 별도 시점에서 발췌한 화면 녹화" />
        <figcaption><span>작업 상태 화면 · 18초 발췌</span><span>별도 시점 편집</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="palpa-section page-shell" id="motion" aria-labelledby="motion-title">
    <div class="palpa-section__header">
      <p class="palpa-label">04 / Motion chaining</p>
      <div>
        <h2 id="motion-title">다음 이동을 보내는<br />시점을 바꾸다</h2>
        <p>경유점마다 도착을 기다리면 감속과 재출발이 반복됩니다. 자동 시퀀스는 목표까지 남은 관절각을 확인하고, 설정한 범위에 들어오면 다음 비동기 이동 명령을 전달하도록 구성했습니다.</p>
      </div>
    </div>
    <div class="palpa-motion-rule palpa-section__body">
      <div class="palpa-formula">
        <p class="palpa-label">Transition condition</p>
        <h3>여섯 관절 중<br />가장 큰 잔여각을 기준으로</h3>
        <p class="palpa-formula__expression" aria-label="1번부터 6번 관절 중 목표 관절각과 현재 관절각의 차이의 최댓값이 lead 이하이면 전환">
          <span>max<sub>j = 1…6</sub> |q<sub>via,j</sub> − q<sub>current,j</sub>|</span>
          <strong>≤ lead_deg</strong>
        </p>
        <p>현재 경유 목표와 관절 피드백의 차이를 비교해 다음 절대 목표를 보냅니다. 체인의 마지막 작업점에서는 도착·정지를 확인합니다.</p>
      </div>
      <div class="palpa-thresholds">
        <p class="palpa-label">구간별 설정 예시 / 단위 °</p>
        <dl>
          {thresholds.map(([name, value, note]) => (
            <div><dt>{name}<small>{note}</small></dt><dd>{value}</dd></div>
          ))}
        </dl>
        <p class="palpa-note">lead는 최대 잔여 관절각의 임계값입니다. 4°는 폐기통 복귀 P29의 설정이며, 모든 작업점에 적용하는 값이 아닙니다.</p>
      </div>
    </div>

    <div class="palpa-subsection" id="motion-policy">
      <div class="palpa-subsection__heading">
        <p class="palpa-label">Execution policy</p>
        <div><h3>통과점은 연결하고,<br />작업점은 확인하다</h3><p>다음 목표의 전송 조건을 비교한 실행 정책입니다. 도식은 실측 궤적을 나타내지 않습니다.</p></div>
      </div>
      <div class="palpa-comparison">
        <div>
          <p class="palpa-label">Sequential / 문서 기록</p>
          <h4>각 목표의 도착을 기다림</h4>
          <ol><li>경유점 V1 목표 전송</li><li>V1 도착·정지 확인</li><li>V2에서도 도착 확인 후 작업점 B로 이동</li></ol>
        </div>
        <div>
          <p class="palpa-label">Chained / 현재 코드</p>
          <h4>잔여각 조건에서 다음 목표로</h4>
          <ol><li>경유점 V1 목표 전송</li><li>잔여각 ≤ L1이면 V2, ≤ L2이면 B 전송</li><li>마지막 작업점 B에서 도착·정지 확인</li></ol>
        </div>
      </div>
      <p class="palpa-boundary">이 구현은 컨트롤러에 보낼 목표의 시점을 조정합니다. 자체 spline·jerk 궤적 생성이나 모든 중간 waypoint의 정확 통과를 보장하는 방식은 아닙니다.</p>
      <details class="palpa-details">
        <summary>전환 조건·전체 설정과 실행 정책 비교 도해</summary>
        <div class="palpa-details__body">
          {diagrams.map(([file, alt, height]) => (
            <figure class="palpa-evidence">
              <div class="palpa-diagram-scroll" role="region" aria-label="모션 설명 도해, 작은 화면에서는 가로 스크롤" tabindex="0">
                <img src={asset(String(file))} alt={String(alt)} width="1440" height={Number(height)} loading="lazy" decoding="async" />
              </div>
              <figcaption><span>코드 기반 개념도 · 실측 궤적 아님</span><a href={asset(String(file))} target="_blank" rel="noopener">도해 크게 보기 ↗</a></figcaption>
            </figure>
          ))}
        </div>
      </details>
    </div>

    <div class="palpa-subsection" id="speed">
      <div class="palpa-subsection__heading">
        <p class="palpa-label">Tune &amp; run</p>
        <div><h3>구간별 설정을 바꾸고,<br />실제 경로에서 확인하다</h3><p>속도 탭에서는 이동 구간별 값을 조정하고 출발점부터 도착점까지 실행할 수 있습니다. 저장된 19종 이동 설정을 바탕으로 경로를 튜닝하는 운용 화면입니다.</p></div>
      </div>
      <figure class="palpa-evidence palpa-speed-evidence">
        <picture>
          <source media="(max-width: 760px)" srcset={asset('palpa-speed-settings.webp')} width="694" height="914" />
          <img src={asset('palpa-speed.webp')} width="1256" height="924" loading="lazy" decoding="async"
            alt="허브 진입, 슬롯 접근 등 이동별 속도를 설정하는 실제 운용 화면. 모바일은 설정 패널 확대본" />
        </picture>
        <figcaption><span>구간별 속도 설정 · 모바일은 설정 패널 확대</span><a href={asset('palpa-speed.webp')} target="_blank" rel="noopener">전체 화면 확대 ↗</a></figcaption>
      </figure>
      <p class="palpa-note">화면의 60과 배속 100%는 촬영 당시의 명령 설정입니다. 실측 속도나 성능 향상률을 나타내지 않으며, ‘테스트 주문’도 실제 로봇 실행을 호출합니다.</p>
    </div>
    <div class="palpa-subsection" id="motion-example">
      <div class="palpa-subsection__heading">
        <p class="palpa-label">Physical motion</p>
        <div><h3>뚜껑 이송에서<br />다음 슬롯 접근까지</h3><p>실제 로봇이 이어서 이동하는 모습을 확인할 수 있는 장면입니다. 위 설정 화면과는 별도로 촬영된 자료입니다.</p></div>
      </div>
      <figure class="palpa-evidence">
        <ProjectVideo src={asset('palpa-motion-example.mp4')} poster={asset('palpa-motion-poster.webp')}
          captions={asset('palpa-motion-example.ko.vtt')} width={1280} height={720}
