---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectHero from '@/components/ProjectHero.astro';
import { projectBySlug } from '@/data/projects';
import { withBase } from '@/utils/paths';

const project = projectBySlug.palpa;
---

<BaseLayout
  title={`${project.title} — Bae Cheolgyu`}
  description={project.description}
  bodyClass="project-page project-page--palpa"
>
  <ProjectHero project={project} note="ROBOT CONTROL / PAGE DRAFT" />

  <section class="project-question page-shell" aria-labelledby="palpa-question">
    <h2 id="palpa-question">Question to prove</h2>
    <blockquote>{project.futureQuestion}</blockquote>
  </section>

  <section class="content-slots page-shell" aria-labelledby="palpa-slots">
    <div class="content-slots__heading">
      <h2 id="palpa-slots">Before / after slots</h2>
      <p>
        티칭 펜던트 조작과 로봇 움직임 품질을 비교할 수 있는 실제 자료를 나란히
        설명하기 위한 자리입니다. 현재는 결과를 단정하지 않습니다.
      </p>
    </div>
    <div class="slot-list">
      <div class="slot-list__item">
        <span>I</span><strong>Operator input</strong><p>[웹 조작 인터페이스 자료 삽입]</p>
      </div>
      <div class="slot-list__item">
        <span>II</span><strong>Trajectory / waypoint</strong><p>[분석 후 제어 흐름 삽입]</p>
      </div>
      <div class="slot-list__item">
        <span>III</span><strong>Movement comparison</strong><p>[Before / after 근거 삽입]</p>
      </div>
    </div>
  </section>

  <section class="project-note">
    <div class="project-note__inner page-shell">
      <h2>Analysis pending</h2>
      <div class="project-note__copy">
        <p>
          제어 주기, 보간 방식, 안전 처리, 개선 전후 결과는 프로젝트 분석이 끝난 뒤
          실제 구현 근거로 작성합니다.
        </p>
        <p>
          `docs/portfolio-source/palpa/project-page-spec.md`가 이 페이지의 최종 콘텐츠
          소스가 됩니다.
        </p>
      </div>
    </div>
  </section>

  <section class="project-metadata page-shell" aria-label="프로젝트 초안 상태">
    <dl>
      <div><dt>Role</dt><dd>[프로젝트 분석 후 반영]</dd></div>
      <div><dt>Status</dt><dd>Project analysis pending</dd></div>
      <div><dt>Content source</dt><dd>project-page-spec.md 예정</dd></div>
    </dl>
  </section>

  <section class="project-resources page-shell" aria-labelledby="palpa-resources">
    <div class="project-resources__heading">
      <h2 id="palpa-resources">Demo / source</h2>
      <p>검증된 데모와 공개 가능한 저장소만 최종 페이지에 연결합니다.</p>
    </div>
    <dl class="resource-list">
      <div><dt>Demo</dt><dd>[프로젝트 분석 후 연결]</dd></div>
      <div><dt>GitHub</dt><dd>[공개 저장소 여부 사용자 확인 필요]</dd></div>
      <div><dt>Source note</dt><dd>docs/portfolio-source/palpa/project-page-spec.md</dd></div>
    </dl>
  </section>

  <nav class="next-project page-shell" aria-label="프로젝트 목록으로 돌아가기">
    <a href={withBase('/#projects')}>
      <span>Back to index</span><strong>All projects</strong>
    </a>
  </nav>
</BaseLayout>
