---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectNavigation from '@/components/ProjectNavigation.astro';
import ProjectHero from '@/components/ProjectHero.astro';
import ProjectVideo from '@/components/ProjectVideo.astro';
import ProjectCodeLinks from '@/components/ProjectCodeLinks.astro';
import { projectBySlug } from '@/data/projects';
import sources from '@/data/project-sources.json';
import { withBase } from '@/utils/paths';
import '@/styles/case-study.css';

const project = projectBySlug.palpa;
const source = sources.palpa;
const asset = (file: string) => withBase('/projects/palpa/' + file);
const motionCode = [
  '# 핵심 전환 원리를 요약한 코드',
  'send_move_joint(via, sync_type=1, radius=0)',
  'while max(abs(via[j] - current[j]) for j in range(6)) > lead_deg:',
  '    current = read_joint_state()',
  'send_move_joint(next_target, sync_type=1, radius=0)',
  '# 마지막 작업점에서는 도착과 정지를 별도 확인',
].join('\n');
---
<BaseLayout title="PALPA · 웹 티칭과 연속 동작 — Bae Cheolgyu" description={project.description} bodyClass="project-page case-study">
  <ProjectHero project={project} titleLines={['PALPA']}
    tagline="웹에서 조작하고, 로봇의 이동을 이어가다"
    intro="공을 분류하고 주문에 맞춰 포장하는 협동로봇 프로젝트입니다. 웹 티칭펜던트와 작업 중 이동이 자연스럽게 이어지도록 하는 연속 동작 구현을 담당했습니다."
    contributions={['두산 로봇팔 티칭펜던트 웹 구현', '공 분류·주문 포장 과정의 연속 동작 구현']}
    team="4인 팀" platform="Doosan M0609 · OnRobot RG2 · ROS2"
    repository={source.repository}
    sections={[{href:'#teaching',label:'웹 티칭 구현'},{href:'#motion',label:'연속 동작과 문제 해결'},{href:'#results',label:'시연 결과'}]}>
    <figure class="case-figure">
      <ProjectVideo src={asset('palpa-demo.mp4')} poster={asset('palpa-demo-poster.webp')}
        captions={asset('palpa-demo.ko.vtt')} width={1280} height={800} autoplay={true} loop={false}
        label="주문, 공 분류와 이송, 뚜껑 체결, 포장 완료를 보여주는 PALPA 팀 시연" />
      <figcaption><span>주문 → 공 분류 → 포장 완료</span><span>실제 장비 · 31초 편집 요약 · 무음</span></figcaption>
      <p class="case-note">주요 장면을 연결한 팀 시연입니다. 첫 주문 화면은 고객용 웹이며, 아래 티칭펜던트는 로봇 운용 화면입니다. 영상 길이는 주문 처리 시간이 아닙니다.</p>
    </figure>
  </ProjectHero>

  <section class="case-section page-shell" id="teaching" aria-labelledby="teaching-title">
    <header class="case-heading">
      <p class="case-label">01 / Web teaching</p>
      <div><h2 id="teaching-title">자세 조정부터 작업점 재실행까지</h2><p>공 분류·포장 경로를 조정하려면 로봇의 자세를 움직이는 것과 작업점을 저장하는 일이 연결되어야 했습니다. 제가 맡은 웹 티칭펜던트는 이 과정을 한 화면에서 다룰 수 있도록 구성했습니다.</p></div>
    </header>
    <div class="case-grid">
      <figure class="case-figure">
        <img src={asset('palpa-teaching.webp')} width="1416" height="1077" loading="lazy" decoding="async" alt="관절 조그, BASE 좌표 이동, 저장 포인트 목록을 함께 보여주는 PALPA 티칭 화면" />
        <figcaption><span>직접 운용한 티칭 탭</span><a href={asset('palpa-teaching.webp')} target="_blank" rel="noopener">화면 확대 ↗</a></figcaption>
      </figure>
      <div class="case-copy">
        <h3>조작·저장·호출을 하나의 흐름으로</h3>
        <dl class="case-facts">
          <div><dt>자세 조정</dt><dd>J1–J6 관절 조그와 BASE 좌표 이동으로 작업 자세를 맞춥니다.</dd></div>
          <div><dt>작업점 저장</dt><dd>현재 관절각에 이름·메모·역할을 붙여 JSON으로 보존합니다. 좌표를 바꾸려면 새 자세를 저장합니다.</dd></div>
          <div><dt>다시 실행</dt><dd>저장된 작업점을 호출해 이동을 확인하고, 공정에 필요한 경유 위치를 조정합니다.</dd></div>
        </dl>
      </div>
    </div>
    <div id="command" class="case-anchor">
      <ol class="case-steps" aria-label="웹 조작과 로봇 명령의 연결">
        <li><strong>웹 입력 → HTTP 요청</strong><p>조그·저장 포인트 요청을 Python 서버에 전달하고 입력과 실행 상태를 확인합니다.</p></li>
        <li><strong>실행 워커 → 로봇 서비스</strong><p>JogWorker가 요청에 따라 ROS2 MoveJoint·MoveLine 서비스를 호출합니다.</p></li>
        <li><strong>로봇 상태 → 화면</strong><p>관절·작업 상태를 500ms 간격으로 조회해 표시합니다. 이동 중 일부 서비스 값의 갱신은 보류될 수 있습니다.</p></li>
      </ol>
    </div>
    <ProjectCodeLinks links={[source.links.teaching,source.links.store,source.links.api]} />
    <details class="case-details">
      <summary>티칭 화면 확대와 명령·피드백 구조</summary>
      <div class="case-details__body">
        <div class="case-grid">
          <figure class="case-figure"><img src={asset('palpa-teaching-jog.webp')} width="564" height="965" loading="lazy" alt="관절 조그와 BASE 이동 조작 확대" /><figcaption>관절·BASE 조작</figcaption></figure>
          <figure class="case-figure"><img src={asset('palpa-teaching-waypoints.webp')} width="656" height="965" loading="lazy" alt="이름과 관절각, 역할이 표시된 저장 포인트 목록 확대" /><figcaption>저장 포인트·재실행</figcaption></figure>
        </div>
        <div class="case-diagram" tabindex="0" role="region" aria-label="웹 명령과 ROS2 연결 상세 도해">
          <img src={asset('palpa-control-flow.svg')} width="1440" height="900" loading="lazy" alt="웹에서 HTTP Handler와 JogWorker를 거쳐 로봇 명령과 상태 피드백으로 연결되는 구조" />
        </div>
        <p>고객 주문은 별도의 FastAPI·ROS2 주문 인터페이스로 전달됩니다. 위 구조는 운용 펜던트에서 로봇을 직접 조작하는 경로입니다.</p>
      </div>
    </details>
  </section>

  <section class="case-section page-shell" id="motion" aria-labelledby="motion-title">
    <span id="troubleshooting" class="case-anchor"></span>
    <header class="case-heading">
      <p class="case-label">02 / Motion · Troubleshooting</p>
      <div><h2 id="motion-title">경유점에서 멈추는 대신,<br />다음 명령을 보내는 시점을 조정하다</h2><p>경유점마다 도착을 기다리면 감속과 재출발이 반복됩니다. 연속 동작 구현에서는 남은 관절각을 기준으로 다음 비동기 이동 명령을 보내고, 실제 작업을 수행할 마지막 점에서는 도착·정지를 확인하도록 구성했습니다.</p></div>
    </header>
    <ol class="case-steps">
      <li><strong>문제: radius 설정만으로 연결되지 않음</strong><p>프로젝트 기록에는 radius 값을 바꿔도 기대한 경유 이동이 나오지 않았던 문제가 있습니다.</p></li>
      <li><strong>원인 확인: 요청 필드와 호출 분기</strong><p>확인한 Doosan Humble 드라이버는 동기 movej에 radius를 전달하지만 비동기 amovej 호출에는 전달하지 않습니다.</p></li>
      <li><strong>적용: 잔여각 기반 전환</strong><p>radius=0인 비동기 명령을 사용하고, 여섯 관절 중 최대 잔여각이 구간별 기준에 들어오면 다음 목표로 연결합니다.</p></li>
    </ol>
    <div class="case-grid">
      <div class="case-copy">
        <p class="case-formula">max |q<sub>via</sub> − q<sub>current</sub>| ≤ lead_deg<br />→ 다음 목표 전송</p>
        <div class="case-comparison" id="motion-policy">
          <div><p class="case-label">경유점</p><h3>잔여각 조건에서 연결</h3><p>완전 도착을 기다리는 구간을 줄여 다음 이동으로 이어갑니다.</p></div>
          <div><p class="case-label">마지막 작업점</p><h3>도착·정지를 확인</h3><p>파지·체결 등 다음 작업을 시작하기 전에 최종 상태를 확인합니다.</p></div>
        </div>
        <p>이 방식은 다음 목표를 보내는 시점을 제어합니다. 자체 spline 궤적 생성이나 모든 경유점의 정확한 통과를 보장하는 방식은 아닙니다.</p>
      </div>
      <figure class="case-figure" id="motion-example">
        <ProjectVideo src={asset('palpa-motion-example.mp4')} poster={asset('palpa-motion-poster.webp')}
          captions={asset('palpa-motion-example.ko.vtt')} width={1280} height={720}
          label="PALPA 로봇이 뚜껑을 이송한 뒤 다음 슬롯으로 접근하는 실제 동작" />
        <figcaption><span>뚜껑 이송 → 다음 슬롯 접근</span><span>11초 · 원본 속도</span></figcaption>
        <p class="case-note">실기 동작 예시입니다. 당시 관절 로그·설정과 동기화된 전후 비교 자료는 없어 특정 lead 값의 개선 효과를 수치화하지 않았습니다.</p>
      </figure>
    </div>
    <ProjectCodeLinks links={[source.links.motion,source.links.investigation]} />
    <details class="case-details" id="speed">
      <summary>전환 설정·축약 코드·구간별 속도 화면</summary>
      <div class="case-details__body">
        <p>lead는 최대 잔여 관절각의 임계값입니다. P5 허브 45°, 일반 경유점 25°, 폐기 복귀 P29 4°처럼 구간별로 다르게 설정합니다. 4°를 모든 작업점에 적용하지 않습니다.</p>
        <pre class="case-code" tabindex="0"><code>{motionCode}</code></pre>
        <figure class="case-figure"><img src={asset('palpa-speed.webp')} width="1256" height="924" loading="lazy" alt="이동 구간별 속도를 설정하고 실제 경로를 실행하는 PALPA 운용 화면" /><figcaption><span>19종 이동 설정을 조정하는 속도 탭</span><a href={asset('palpa-speed.webp')} target="_blank" rel="noopener">확대 ↗</a></figcaption></figure>
        <ProjectCodeLinks links={[source.links.settings]} />
        <p>공식 <a href="https://github.com/DoosanRobotics/doosan-robot2/blob/humble/dsr_controller2/src/dsr_controller2.cpp" target="_blank" rel="noopener">드라이버 호출 분기 ↗</a>와 <a href="https://manual.doosanrobotics.com/en/programming-manual/3.4.0/publish/amovej" target="_blank" rel="noopener">amovej 설명 ↗</a>을 근거로 정리했습니다. 실기 설치 드라이버·펌웨어와 정확히 같은 버전인지는 확인되지 않았습니다.</p>
        <p>현재 lead 대기 timeout의 반환값을 호출부가 처리하지 않는 경로가 남아 있습니다. timeout 시 중단·복구는 추가 개선 항목입니다. 설정 화면의 ‘테스트 주문’도 실제 로봇 실행을 호출합니다.</p>
      </div>
    </details>
  </section>

  <section class="case-result" id="results" aria-labelledby="result-title">
    <div class="page-shell">
      <p class="case-label">03 / Result</p><h2 id="result-title">웹 조작과 연속 이동을<br />공 분류·포장 시연으로 연결했습니다</h2>
      <p class="case-result__lead">티칭펜던트에서는 자세·작업점을 관리하고, 자동 공정에는 잔여 관절각에 따른 이동 연결을 적용했습니다. 팀 시연에서는 공의 판별·이송과 뚜껑 체결, 포장 완료 표시까지 확인할 수 있습니다.</p>
      <div class="case-result__grid">
        <div><h3>담당 구현에서 보여준 것</h3><p>사용자 조작을 로봇 명령과 상태 피드백에 연결하고, 경유 이동과 마지막 작업점에 서로 다른 실행 조건을 적용했습니다.</p><h3 class="case-subsection">남은 검증</h3><p>같은 조건의 변경 전후 시간·정지 횟수·관절 로그와 장시간 반복시험이 필요합니다. lead timeout 처리도 보완해야 합니다.</p></div>
        <figure class="case-figure"><img src={asset('palpa-result.webp')} width="1152" height="880" loading="lazy" alt="단일 시연에서 주문 공 3개 포장 완료와 무게를 표시한 결과 화면" /><figcaption>단일 시연 결과 · 화면의 3/3·581g은 독립 검증한 성능 지표가 아닙니다.</figcaption></figure>
      </div>
    </div>
  </section>
  <section class="case-appendix page-shell" aria-label="보조 시연과 검증 조건">
    <details class="case-details">
      <summary>작업 진행·완료 화면과 검증 조건</summary>
      <div class="case-details__body">
        <figure class="case-figure"><ProjectVideo src={asset('palpa-feedback.mp4')} poster={asset('palpa-feedback-poster.webp')} captions={asset('palpa-feedback.ko.vtt')} width={1160} height={956} loop={false} label="운용 콘솔에서 작업 진행과 완료 상태를 확인하는 발췌 영상" /><figcaption>18초 · 서로 다른 시점의 화면 발췌 · 응답 지연 측정 자료 아님</figcaption></figure>
        <p>소프트웨어 중단 요청과 상태 확인만으로 정지 지연·충돌 안전성을 보장하지 않습니다. 기존 Windows 분석 환경에서는 전체 테스트가 통과하지 않았으며, 실제 장비 시연과 반복 운용 검증은 구분합니다.</p>
      </div>
    </details>
  </section>
  <ProjectNavigation slug="palpa" />
</BaseLayout>
