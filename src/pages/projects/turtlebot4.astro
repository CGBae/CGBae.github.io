---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectNavigation from '@/components/ProjectNavigation.astro';
import ProjectHero from '@/components/ProjectHero.astro';
import ProjectVideo from '@/components/ProjectVideo.astro';
import ProjectCodeLinks from '@/components/ProjectCodeLinks.astro';
import { projectBySlug } from '@/data/projects';
import sources from '@/data/project-sources.json';
import { withBase } from '@/utils/paths';
import '@/styles/case-study.css';

const project = projectBySlug.turtlebot4;
const source = sources.turtlebot4;
const asset = (file: string) => withBase('/projects/turtlebot4/' + file);
---
<BaseLayout title="TurtleBot4 · 추론 결과와 ROS2 제어 통합 — Bae Cheolgyu" description={project.description} bodyClass="project-page case-study">
  <ProjectHero project={project} titleLines={['TurtleBot4']}
    tagline="탐지한 위치를 두 로봇의 주행과 복귀로"
    intro="유해동물을 감지하고 두 로봇이 출구 방향으로 유도하는 팜가드봇 프로젝트입니다. 전달받은 인식 모델의 추론 결과를 ROS2 제어 입력에 연결하고, 몰이 구현 지원과 실기기 통합 검증을 담당했습니다."
    contributions={['ROS2 인터페이스 통합·추론 결과의 제어 연결', '몰이 구현 지원·시뮬레이션 및 실기기 통합 검증']}
    team="8인 팀" platform="TurtleBot4 2대 · ROS2 · Nav2"
    repository={source.repository}
    sections={[{href:'#contribution',label:'ROS2 통합'},{href:'#mission',label:'주행·복귀 연결'},{href:'#validation',label:'통합 검증 결과'}]}>
    <figure class="case-figure">
      <ProjectVideo src={asset('demo-32s.mp4')} poster={asset('hero-poster.webp')} width={1440} height={616}
        autoplay={true} loop={false} label="실내 모형 목표에 접근하고 출구 쪽에 배치된 뒤 복귀하는 두 TurtleBot4의 팀 시연" />
      <figcaption><span>실내 모형 시연 · 접근·유도 배치 → 복귀</span><span>32초 발췌 · 원본 3배속 유지</span></figcaption>
      <p class="case-note">원본 00:00–00:14와 00:42–01:00을 연결했습니다. 14초에서 복귀 장면으로 전환되며, 실제 작업 소요 시간을 나타내지는 않습니다.</p>
    </figure>
  </ProjectHero>

  <section class="case-section page-shell" id="contribution" aria-labelledby="contribution-title">
    <header class="case-heading">
      <p class="case-label">01 / My role · ROS2 integration</p>
      <div><h2 id="contribution-title">추론 결과와 로봇 실행 사이의 데이터 흐름을 맞추다</h2><p>카메라가 탐지한 픽셀과 로봇이 사용하는 지도 좌표는 서로 다릅니다. 제 역할은 팀의 인식·몰이·AMR 모듈이 연결되도록 ROS2 인터페이스를 통합하고, 추론 결과가 목표 생성과 실제 주행까지 이어지는지 확인하는 것이었습니다.</p></div>
    </header>
    <ol class="case-steps" aria-label="통합한 주요 데이터 흐름">
      <li><strong>인식 출력 → 지도 위 위치</strong><p>탐지 박스의 하단 중앙을 homography로 map 평면에 투영하고, 제어 모듈이 사용할 PoseStamped로 전달합니다.</p></li>
      <li><strong>목표 위치 → 로봇별 주행 목표</strong><p>팀의 몰이 판단 모듈이 목표·출구·두 로봇의 위치를 받아 각 로봇의 접근 위치와 방향을 생성합니다.</p></li>
      <li><strong>주행 목표 → 실행 상태</strong><p>로봇별 실행 노드가 Nav2 action을 수행합니다. 목표 갱신과 미션 완료 신호를 주행·복귀 상태에 연결합니다.</p></li>
    </ol>
    <div class="case-grid case-subsection" id="localization">
      <figure class="case-figure">
        <img src={asset('target-localization.webp')} width="1240" height="926" loading="lazy" decoding="async" alt="고정 카메라 탐지 화면에서 bbox 하단의 foot pixel과 변환된 map 좌표를 함께 표시한 실제 관제 화면" />
        <figcaption><span>추론 결과의 foot pixel → map 좌표 표시</span><a href={asset('target-localization.webp')} target="_blank" rel="noopener">화면 확대 ↗</a></figcaption>
      </figure>
      <div class="case-copy">
        <h3>모듈 사이에서 맞춰야 하는 기준</h3>
        <dl class="case-facts">
          <div><dt>좌표계</dt><dd>제어 입력은 map 기준의 x·y와 z=0입니다. 고정 카메라·지면 평면 가정이므로 카메라 위치가 달라지면 보정도 다시 확인해야 합니다.</dd></div>
          <div><dt>대상과 로봇 구분</dt><dd>공통 목표 위치와 로봇별 위치·목표 토픽을 나눠, 두 로봇이 자신의 실행 목표를 받도록 연결합니다.</dd></div>
          <div><dt>위치 갱신과 출동 구분</dt><dd>유효 검출의 위치 발행과 연속 감지 후 출동 신호를 구분합니다. 탐지 한 번과 미션 시작을 같은 이벤트로 취급하지 않습니다.</dd></div>
        </dl>
      </div>
    </div>
    <ProjectCodeLinks links={[source.links.detection, source.links.calibration, source.links.goal]} />
    <details class="case-details">
      <summary>실제 토픽·메시지와 좌표 변환 과정</summary>
      <div class="case-details__body">
        <div class="case-table-scroll" role="region" aria-label="ROS2 인터페이스 표, 작은 화면에서 가로 스크롤" tabindex="0">
          <table class="case-table case-table--contracts"><caption>ns는 robot8 또는 robot11 · 공개 구현 기준</caption><thead><tr><th scope="col">데이터</th><th scope="col">토픽 · 타입</th><th scope="col">연결</th></tr></thead><tbody>
            <tr><th scope="row">탐지 위치</th><td>/world/animal_pose · PoseStamped</td><td>추론·좌표 변환 → 몰이 판단</td></tr>
            <tr><th scope="row">로봇 위치</th><td>/&lt;ns&gt;/amcl_pose · PoseWithCovarianceStamped</td><td>각 로봇 → 몰이 판단</td></tr>
            <tr><th scope="row">로봇별 목표</th><td>/&lt;ns&gt;/flank_goal · PoseStamped</td><td>몰이 판단 → 각 로봇 실행</td></tr>
            <tr><th scope="row">출동·종료</th><td>/undock_signal · /mission_complete · Bool</td><td>탐지·판단 → 실행 상태 전환</td></tr>
          </tbody></table>
        </div>
        <p>bbox 하단 중앙 [u, v, 1]에 보정 행렬 H를 곱하고 동차좌표를 정규화해 x·y를 얻습니다. 3프레임 연속 감지는 출동 확정 조건이며, 유효 위치는 검출마다 발행합니다. 메시지 시각은 이미지 캡처 시각이 아닌 처리 시각입니다.</p>
        <figure class="case-figure">
          <div class="case-diagram" role="region" aria-label="픽셀에서 map 좌표로의 변환 도식, 작은 화면에서 가로 스크롤" tabindex="0">
            <img src={asset('localization-flow.svg')} width="1440" height="870" loading="lazy" decoding="async" alt="bbox 하단 중앙, homography 투영, 동차좌표 정규화, ROS2 map 위치 발행의 네 단계" />
          </div>
          <figcaption><span>고정 카메라의 지면 평면 투영</span><a href={asset('localization-flow.svg')} target="_blank" rel="noopener">도식 확대 ↗</a></figcaption>
        </figure>
        <p>모델 학습과 몰이·AMR 제어는 팀의 구현입니다. 저는 ROS2 통합, 추론 결과 연결, 몰이 구현 지원과 검증을 맡았습니다. 평면 투영은 카메라 3D 점의 TF2 변환과 별도이며, 보정점의 재투영 오차를 실제 위치 정확도로 해석하지 않습니다.</p>
      </div>
    </details>
    <details class="case-details" id="herding-goal">
      <summary>연결한 팀 구현 — 두 로봇의 몰이 목표 생성</summary>
      <div class="case-details__body">
        <div class="case-grid">
          <figure class="case-figure">
            <img src={asset('herding-geometry-detail.svg')} width="796" height="705" loading="lazy" decoding="async" alt="동물과 출구를 기준으로 후방 축의 좌우 75도, 반경 0.5미터에 생성한 두 로봇의 주행 목표" />
            <figcaption><span>몰이 목표 기하 · 코드 기본값</span><a href={asset('herding-geometry.svg')} target="_blank" rel="noopener">전체 도식 ↗</a></figcaption>
          </figure>
          <div class="case-copy">
            <h3>출구 방향과 로봇의 상대 위치 반영</h3>
            <p>동물에서 출구 반대 방향을 기준으로 ±75°, 반경 0.5m에 두 후보점을 만듭니다. 현재 로봇의 방위각 비용으로 좌우를 배정하고, 20° hysteresis로 잦은 역할 전환을 줄입니다.</p>
            <p>0.5초마다 판단하되 동물이 마지막 목표 생성 위치에서 0.4m를 초과해 이동하면 갱신합니다. 좌표는 fence 안쪽 0.3m 여유로 제한하고, 도착 방향은 동물을 향하도록 지정합니다.</p>
            <p>도식의 점선은 목표 배정 관계입니다. 실내 모형의 유도 배치 구현이며, 야생동물의 반응이나 실제 주행 궤적을 측정한 결과는 아닙니다.</p>
          </div>
        </div>
        <ProjectCodeLinks links={[source.links.goal]} />
      </div>
    </details>
  </section>

  <section class="case-section page-shell" id="mission" aria-labelledby="mission-title">
    <header class="case-heading">
      <p class="case-label">02 / Mission execution</p>
      <div><h2 id="mission-title">명령 전송 이후의 상태까지 연결하기</h2><p>목표점을 보내는 것만으로 미션이 끝나지는 않습니다. 통합 과정에서는 각 로봇의 action 수락·완료 결과와 미션 종료 신호가 어떻게 구분되고, 다음 동작으로 이어지는지 함께 살펴봤습니다.</p></div>
    </header>
    <ol class="case-steps" aria-label="출동에서 복귀까지의 실행 흐름">
      <li><strong>출동 신호 → Undock</strong><p>출동을 확정한 뒤 도크 이탈 action을 요청하고 결과에 따라 주행을 시작합니다.</p></li>
      <li><strong>NavigateToPose → 목표 갱신</strong><p>로봇별 목표로 주행하고, 갱신된 목표와 이전 action의 결과가 충돌하지 않도록 순번을 관리합니다.</p></li>
      <li><strong>미션 완료 → 복귀·Dock</strong><p>완료 신호를 받으면 지정된 복귀 위치로 이동하고 도킹을 요청합니다. 실패에는 횟수 제한과 backoff가 있습니다.</p></li>
    </ol>
    <div class="case-comparison">
      <div><p class="case-label">Integration point</p><h3>늦게 도착한 이전 결과</h3><p>Goal n을 실행하던 중 새 Goal n+1이 들어오면, 나중에 도착한 n의 결과가 현재 상태를 바꾸지 않도록 해야 합니다.</p></div>
      <div><p class="case-label">Execution contract</p><h3>현재 목표 순번과 비교</h3><p>팀 실행 코드의 <code>_nav_seq</code>를 callback에 저장한 순번과 비교합니다. 현재 순번과 다른 결과는 무시하고 최신 목표의 상태를 유지합니다.</p></div>
    </div>
    <p class="case-note case-boundary">미션 완료는 마지막 목표 좌표가 fence 밖에서 0.5초 경과한 경우로 판단합니다. Nav2 목표 도달, 특정 출구 통과, 도킹·충전 완료는 각각 별도의 상태입니다.</p>
    <ProjectCodeLinks links={[source.links.execution, source.links.goal]} />
    <details class="case-details"><summary>미션 상태와 재시도·근접 분기 도식</summary><div class="case-details__body">
      <figure class="case-figure">
        <div class="case-diagram" role="region" aria-label="미션 실행 상세 도식, 작은 화면에서 가로 스크롤" tabindex="0">
          <img src={asset('mission-flow.svg')} width="1440" height="1130" loading="lazy" decoding="async" alt="출동, Nav2 실행, 완료 판정, 복귀와 도킹, 이전 결과 무시 및 근접 정지 분기를 설명하는 코드 기반 도식" />
        </div>
        <figcaption><span>공개 코드의 실행 상태 흐름</span><a href={asset('mission-flow.svg')} target="_blank" rel="noopener">도식 확대 ↗</a></figcaption>
      </figure>
    </div></details>
  </section>

  <section class="case-section page-shell" id="troubleshooting" aria-labelledby="troubleshooting-title">
    <header class="case-heading">
      <p class="case-label">03 / Hardware integration</p>
      <div><h2 id="troubleshooting-title">화면의 좌표와 실제 움직임을 함께 확인하다</h2><p>실기기 통합 검증에서는 관제 화면의 목표 위치, RViz의 지도·scan, 두 로봇의 접근과 복귀를 함께 살펴봤습니다. 단일 모듈 실행으로 드러나지 않는 좌표·시각·로봇 간 상호작용을 확인하는 과정이었습니다.</p></div>
    </header>
    <figure class="case-figure">
      <img src={asset('rviz-context.webp')} width="1510" height="620" loading="lazy" decoding="async" alt="실기기 통합 중 RViz에 표시된 실내 지도, 로봇과 LiDAR scan" />
      <figcaption><span>실제 통합 화면 · RViz 지도와 scan</span><a href={asset('rviz-context.webp')} target="_blank" rel="noopener">화면 확대 ↗</a></figcaption>
    </figure>
    <div class="case-comparison">
      <div><p class="case-label">Observed</p><h3>두 로봇의 근접과 시각 불일치</h3><p>실기기 영상에는 두 로봇이 근접·접촉한 장면이, 실행 로그에는 TF 시각 범위를 벗어난 변환과 scan 오류가 남아 있습니다. 서로 다른 통합 문제로 나눠 살펴볼 근거입니다.</p></div>
      <div><p class="case-label">Validation boundary</p><h3>대응 코드와 해결 검증을 구분</h3><p>근접 시 goal 취소를 요청하는 SAFE_STOP은 있으나, 재출발의 거리 회복 조건과 반복시험은 더 필요합니다. 특정 TF 설정 변경이나 근접 대응으로 문제가 모두 해결됐다고 단정하지 않았습니다.</p></div>
    </div>
    <details class="case-details"><summary>근접 문제 영상과 TF 로그 자세히 보기</summary><div class="case-details__body">
      <div class="case-grid">
        <figure class="case-figure case-figure--portrait">
          <ProjectVideo src={asset('robot-proximity.mp4')} poster={asset('robot-proximity-poster.webp')}
            width={514} height={684} loop={false} label="두 TurtleBot4가 근접하고 접촉 상태로 움직인 실제 시험의 문제 장면" />
          <figcaption><span>실제 근접 문제 사례</span><span>4.7초</span></figcaption>
        </figure>
        <div class="case-copy">
          <h3>코드에 있는 대응과 남은 조건</h3>
          <p>거리 0.5m 미만에서 Nav2 goal 취소를 요청하고, 상대 로봇의 예상 위치에 따라 목표점을 조정합니다. 다만 현재 양쪽 로봇은 기본 0.1초 대기 후 거리 회복 조건 없이 재출발합니다.</p>
          <p>이는 발표의 High / Low 순차 출발 설명과 차이가 있습니다. 동일 조건의 수정 전후 반복시험과 별도 우회 상태 연결 검증이 필요합니다.</p>
          <ProjectCodeLinks links={[source.links.execution, source.links.goal]} />
        </div>
      </div>
      <figure class="case-figure">
        <div class="case-diagram" role="region" aria-label="TF 오류 원본 로그, 작은 화면에서 가로 스크롤" tabindex="0">
          <img src={asset('tf-log.webp')} width="1220" height="148" loading="lazy" decoding="async" alt="rplidar_link에서 map 변환 시각이 TF buffer 범위를 벗어나 미래 외삽 오류가 발생한 원본 로그" />
        </div>
        <figcaption><span>TF·scan 통합 로그 · 여러 시점의 scrollback</span><a href={asset('tf-log.webp')} target="_blank" rel="noopener">로그 확대 ↗</a></figcaption>
      </figure>
      <p>로그에는 미래 외삽, transform cache보다 오래된 scan, DDS shared-memory 오류와 네트워크 지연이 기록되어 있습니다. 원인별 재현·수정 결과를 모두 확보한 자료는 아닙니다.</p>
    </div></details>
  </section>

  <section class="case-result" id="validation" aria-labelledby="validation-title">
    <div class="page-shell">
      <p class="case-label">04 / Result &amp; next steps</p>
