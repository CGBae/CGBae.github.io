<script>
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const autoplayVideos = document.querySelectorAll<HTMLVideoElement>('.autoplay-media');

  const syncVideoPlayback = () => {
    autoplayVideos.forEach((video) => {
      video.autoplay = !motionPreference.matches;

      if (motionPreference.matches) {
        video.pause();
        return;
      }

      void video.play().catch(() => {
        // Browser policies can still require the visible native controls.
      });
    });
  };

  syncVideoPlayback();
  motionPreference.addEventListener('change', syncVideoPlayback);
</script>
