---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectHero from '@/components/ProjectHero.astro';
import { projectBySlug } from '@/data/projects';
import { withBase } from '@/utils/paths';

const project = projectBySlug.turtlebot4;
const pageTitle = project.title + ' — Bae Cheolgyu';
---

<BaseLayout
  title={pageTitle}
  description={project.description}
  bodyClass="project-page project-page--turtlebot"
>
  <ProjectHero project={project} note="AUTONOMOUS MOBILE ROBOT / DRAFT" />

  <section class="project-note">
    <div class="project-note__inner page-shell">
      <h2>From target position to robot behavior</h2>
      <div class="project-note__copy">
        <p>
          탐지한 목표의 위치를 로봇이 사용할 수 있는 좌표와 Navigation Goal로
          변환하고, 이를 탐색·접근·몰이·복귀 동작으로 연결한 TurtleBot4 기반
          자율주행 프로젝트입니다.
        </p>
        <p>
          현재 페이지는 확인된 프로젝트 흐름을 기준으로 구성한 초안입니다.
          세부 좌표계, 구현 범위, 실행 영상과 개인 기여도는 추가 근거 확인 후
          구체화합니다.
        </p>
      </div>
    </div>
  </section>

  <section class="project-metadata page-shell" aria-label="TurtleBot4 프로젝트 범위">
    <dl>
      <div><dt>Platform</dt><dd>TurtleBot4 · ROS2</dd></div>
      <div><dt>Core focus</dt><dd>Target Localization · TF2 · Nav2</dd></div>
      <div><dt>Page status</dt><dd>Analysis-based draft · Evidence pending</dd></div>
    </dl>
  </section>

  <section class="project-question page-shell" aria-labelledby="turtle-question">
    <h2 id="turtle-question">Engineering question</h2>
    <blockquote>{project.futureQuestion}</blockquote>
  </section>

  <section class="content-slots page-shell" aria-labelledby="turtle-flow">
    <div class="content-slots__heading">
      <h2 id="turtle-flow">Implementation flow</h2>
      <p>
        현재까지 확인된 기술 흐름입니다. 각 단계의 실제 화면, 코드 근거와
        검증 결과는 프로젝트 자료가 준비되는 순서대로 연결합니다.
      </p>
    </div>
    <div class="slot-list">
      <div class="slot-list__item">
        <span>01</span>
        <strong>Target observation</strong>
        <p>탐지 결과에서 이동 목표가 될 대상의 위치 정보를 얻습니다.</p>
      </div>
      <div class="slot-list__item">
        <span>02</span>
        <strong>Coordinate transform</strong>
        <p>TF2를 사용해 목표 위치를 로봇이 이동에 사용할 좌표계로 변환합니다.</p>
      </div>
      <div class="slot-list__item">
        <span>03</span>
        <strong>Navigation goal</strong>
        <p>변환한 목표를 Nav2가 실행할 수 있는 Navigation Goal로 연결합니다.</p>
      </div>
      <div class="slot-list__item">
        <span>04</span>
        <strong>Robot behavior</strong>
        <p>탐색·접근·몰이·복귀로 이어지는 로봇 동작의 실행 근거를 정리합니다.</p>
      </div>
    </div>
  </section>

  <section class="project-resources page-shell" aria-labelledby="turtle-resources">
    <div class="project-resources__heading">
      <h2 id="turtle-resources">Evidence / source</h2>
      <p>
        검증된 실행 자료와 공개 가능한 저장소만 연결합니다. 확인되지 않은 성능이나
        기여 범위는 현재 초안에서 단정하지 않습니다.
      </p>
    </div>
    <dl class="resource-list">
      <div><dt>Demo</dt><dd>[실행 영상 및 RViz 자료 확인 후 연결]</dd></div>
      <div><dt>GitHub</dt><dd>[공개 저장소 여부 사용자 확인 필요]</dd></div>
      <div><dt>Documentation</dt><dd>[프로젝트 분석 자료 추가 예정]</dd></div>
    </dl>
  </section>

  <nav class="next-project page-shell" aria-label="다음 프로젝트">
    <a href={withBase('/projects/automatic-fueling/')}>
      <span>Next project / 02</span><strong>Automatic Fueling Robot</strong>
    </a>
  </nav>
</BaseLayout>
