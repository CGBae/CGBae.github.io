---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectVideo from '@/components/ProjectVideo.astro';
import { projectBySlug } from '@/data/projects';
import { withBase } from '@/utils/paths';
import '@/styles/turtlebot4.css';

const project = projectBySlug.turtlebot4;
const asset = (name: string) => withBase(`/projects/turtlebot4/${name}`);
const pipeline = [
  ['01', '탐지 위치', '고정 카메라 → map 좌표'],
  ['02', '몰이 목표 판단', '출구 방향 · 두 로봇의 상대 위치'],
  ['03', 'Nav2 실행', '목표 갱신 → 주행 → 복귀'],
];
const localization = [
  ['01', '지면 접점 선택', 'bbox 하단 중앙을 목표의 발 지점으로 사용합니다.'],
  ['02', 'Homography 투영', '사전 보정 행렬 H로 픽셀을 map 평면에 투영합니다.'],
  ['03', '동차좌표 정규화', '투영 결과를 마지막 성분으로 나눠 x, y를 얻습니다.'],
  ['04', 'ROS2 위치 발행', 'PoseStamped(map, x, y, z=0)를 제어 노드에 전달합니다.'],
];
const goalRules = [
  ['01', '두 후보점 계산', '출구 반대 축을 ±75° 회전하고, 목표에서 0.5 m 떨어진 Q+ / Q−를 만듭니다.'],
  ['02', '좌우 역할 배정', '현재 로봇과 후보점의 방위각 비용을 비교합니다. 20° hysteresis로 잦은 역할 변경을 줄입니다.'],
  ['03', '이동량에 따라 갱신', '0.5초마다 판단하고, 동물이 마지막 목표 생성 위치에서 0.4 m를 초과해 이동하면 다시 발행합니다.'],
  ['04', '위치와 방향 지정', 'fence 안쪽 0.3 m 여유로 좌표를 제한하고, 도착 지점에서 동물을 바라보는 yaw를 지정합니다.'],
];
const mission = [
  ['01', '출동 신호', '/undock_signal'],
  ['02', '도크 이탈', 'Undock action'],
  ['03', '몰이 목표 실행', 'NavigateToPose'],
  ['04', '완료 신호', '/mission_complete'],
  ['05', '복귀 위치 이동', '지정 dock pose'],
  ['06', '도킹 요청', 'Dock → is_docked'],
];
const evidence = [
  ['실제 시연', '실내 모형 환경에서 두 로봇의 접근·유도 배치·복귀 동작을 확인했습니다.', '발췌 시연 영상'],
  ['현재 코드', '지면 좌표화, 출구 기준 목표 생성, Nav2 action과 복귀·도킹 상태가 구현되어 있습니다.', '탐지 · 목표 생성 · 실행 노드'],
  ['별도 시뮬레이션', 'PGM 지도와 동물 운동 가정을 둔 별도 실험입니다. 실기기 성공률로 환산하지 않습니다.', '팀 시뮬레이션 보고서'],
  ['남은 검증', '실제 야생동물, 비평탄 농지, 장시간 반복 운용과 무충돌 성능은 검증하지 않았습니다.', '후속 검증 범위'],
];
---

<BaseLayout
  title="TurtleBot4 · FarmGuard Bot — Bae Cheolgyu"
  description={project.description}
  bodyClass="project-page project-page--turtlebot"
>
  <section class="turtle-hero page-shell" id="demo" aria-labelledby="turtle-title">
    <header class="turtle-hero__copy">
      <p class="eyebrow">01 / TurtleBot4 · FarmGuard Bot</p>
      <h1 id="turtle-title"><span>Target Position</span><span>to Robot Behavior</span></h1>
      <div class="turtle-hero__intro">
        <p class="turtle-hero__subtitle">탐지한 목표를, 로봇이 움직일 위치로</p>
        <p class="turtle-hero__lead">
          팜가드봇은 유해동물의 출현을 감지하고 로봇이 현장에 접근해 출구 방향으로
          유도하는 시나리오를 다룬 프로젝트입니다. 고정 카메라의 탐지 좌표와
          두 TurtleBot4의 위치를 연결해 목표점 생성, 주행, 복귀 흐름을 구성했습니다.
        </p>
        <ul class="turtle-keywords" aria-label="핵심 기술">
          <li>ROS2</li><li>TurtleBot4</li><li>Nav2 Action</li>
          <li>Homography</li><li>Dynamic Goal</li><li>Mission State</li>
        </ul>
      </div>
      <dl class="turtle-role">
        <div><dt>Role / integration</dt><dd>시스템 통합 · 추론 연결<br />몰이 구현 지원 · 통합 검증</dd></div>
        <div><dt>Team / platform</dt><dd>8인 팀 · TurtleBot4 2대</dd></div>
        <div><dt>Project period</dt><dd>2026.07.06 — 2026.07.13</dd></div>
      </dl>
    </header>
    <figure class="turtle-evidence turtle-hero__demo">
      <ProjectVideo
        src={asset('demo-32s.mp4')} poster={asset('hero-poster.webp')}
        width={1440} height={616} autoplay={true}
        label="모형 목표에 접근하고 출구 쪽에 배치된 뒤 복귀하는 두 TurtleBot4의 발췌 시연"
      />
      <figcaption><span>실내 모형 시연 · 원본 3배속 · 발췌 편집</span><span>32 s excerpt · 접근·유도 배치 → 복귀</span></figcaption>
      <p class="turtle-media-note">14초에서 이후 복귀 장면으로 전환됩니다. 원본 00:00–00:14 + 00:42–01:00 발췌.</p>
    </figure>
  </section>

  <section class="turtle-section page-shell" id="contribution" aria-labelledby="contribution-title">
    <div class="turtle-section__header">
      <p class="turtle-label">01 / Question &amp; role</p>
      <div>
        <h2 id="contribution-title">탐지한 객체의 위치를<br />어떻게 Navigation Goal로 바꿨는가?</h2>
        <p>탐지 결과만으로 로봇이 어디로 가야 하는지가 정해지지는 않습니다. 카메라의 픽셀을 지도 위 위치로 바꾸고, 출구 방향과 두 로봇의 상대 위치를 반영해 각 로봇의 목표를 계산했습니다.</p>
      </div>
    </div>
    <ol class="turtle-pipeline" aria-label="탐지에서 로봇 행동까지의 흐름">
      {pipeline.map(([number, title, note]) => (
        <li><span>{number}</span><strong>{title}</strong><small>{note}</small></li>
      ))}
    </ol>
    <div class="turtle-contribution">
      <p class="turtle-label">My contribution</p>
      <div>
        <p>시스템 구조와 ROS2 데이터 흐름을 통합하고, 전달받은 인식 모델의 추론 결과를 제어 입력에 연결했습니다. 팀의 몰이 제어 구현을 지원하고 시뮬레이션·실기기 통합 검증에 참여했습니다.</p>
        <p class="turtle-media-note">팀 구현: 몰이 목표 생성·AMR 제어 / 기여: ROS2 인터페이스 통합·구현 지원·검증</p>
      </div>
    </div>
  </section>

  <section class="turtle-section page-shell" id="localization" aria-labelledby="localization-title">
    <div class="turtle-section__header">
      <p class="turtle-label">02 / Target localization</p>
      <div>
        <h2 id="localization-title">바닥의 한 점을<br />지도 위 목표 위치로</h2>
        <p>고정 카메라의 탐지 박스에서 하단 중앙을 목표의 지면 접점으로 사용했습니다. 미리 보정한 homography로 이 픽셀을 map 평면 좌표로 바꾸고, PoseStamped로 제어 노드에 전달했습니다.</p>
      </div>
    </div>
    <div class="turtle-localization turtle-section__body">
      <figure class="turtle-evidence">
        <img src={asset('target-localization.webp')}
          alt="고정 카메라 영상에서 모형 목표의 탐지 박스 하단점, foot pixel과 map 좌표를 표시한 실제 화면"
          width="1240" height="926" loading="lazy" decoding="async" />
        <figcaption><span>Fixed-camera detection</span><span>관제 영상 01:25 · 원본 좌표 보존</span></figcaption>
      </figure>
      <div>
        <ol class="turtle-rule-list" aria-label="좌표 변환 단계">
          {localization.map(([number, title, note]) => (
            <li><span>{number}</span><div><h3>{title}</h3><p>{note}</p></div></li>
          ))}
        </ol>
        <p class="turtle-formula" aria-label="픽셀 u, v를 H로 투영한 q를 정규화해 지도 좌표 x, y 계산">
          q = H · [u, v, 1]<sup>T</sup><br />
          (x, y) = (q<sub>x</sub> / q<sub>z</sub>, q<sub>y</sub> / q<sub>z</sub>)
        </p>
      </div>
    </div>
    <p class="turtle-boundary">고정 카메라·지면 평면을 전제로 합니다. 보정점의 재투영 오차와 실제 위치 정확도는 다르며, 카메라 3D 점의 TF2 변환과는 별도의 구현입니다.</p>
    <details class="turtle-details">
      <summary>좌표 변환 도식과 감지 조건</summary>
      <div class="turtle-details__body">
        <p>트랙 ID와 연속 감지 조건으로 출동 신호를 관리합니다. 3프레임 연속 감지는 출동 확정 조건이며, map 위치는 유효 검출마다 발행합니다. 메시지 시각은 이미지 캡처 시각이 아닌 처리 시각입니다.</p>
        <figure class="turtle-evidence">
          <div class="turtle-diagram-scroll" role="region" aria-label="좌표 변환 상세 도식, 작은 화면에서 가로 스크롤" tabindex="0">
            <img src={asset('localization-flow.svg')} alt="bbox 하단 중앙에서 homography 투영, 정규화, map 위치 발행까지의 네 단계"
              width="1440" height="870" loading="lazy" decoding="async" />
          </div>
          <figcaption><span>Code-derived diagram</span><a href={asset('localization-flow.svg')} target="_blank" rel="noopener">도식 크게 보기 ↗</a></figcaption>
        </figure>
      </div>
    </details>
  </section>

  <section class="turtle-section page-shell" id="herding-goal" aria-labelledby="herding-title">
    <div class="turtle-section__header">
      <p class="turtle-label">03 / Herding goal</p>
      <div>
        <h2 id="herding-title">출구를 향하도록,<br />목표의 뒤와 양옆에 위치를 만들기</h2>
        <p>동물과 출구 사이의 방향을 기준으로 두 로봇의 좌우 목표점을 계산했습니다. 출구 반대 축 주위에 목표를 배치하고, 도착했을 때 동물을 바라보도록 방향도 함께 지정합니다.</p>
      </div>
    </div>
    <div class="turtle-geometry turtle-section__body">
      <figure class="turtle-evidence">
        <img src={asset('herding-geometry-detail.svg')}
          alt="목표 A와 출구 G를 기준으로 후방 축의 좌우 75도, 반경 0.5미터에 생성한 두 주행 목표 Q+와 Q−. 채워진 원은 현재 로봇, 빈 원은 목표, 점선은 배정 관계."
          width="796" height="705" loading="lazy" decoding="async" />
        <figcaption><span>Goal geometry · 코드 기본값</span><a href={asset('herding-geometry.svg')} target="_blank" rel="noopener">전체 도식 ↗</a></figcaption>
      </figure>
      <ol class="turtle-rule-list" aria-label="몰이 목표 판단 규칙">
        {goalRules.map(([number, title, note]) => (
          <li><span>{number}</span><div><h3>{title}</h3><p>{note}</p></div></li>
        ))}
      </ol>
    </div>
    <div class="turtle-geometry-formula">
      <p class="turtle-formula" aria-label="A에서 출구 반대 단위벡터를 좌우 75도 회전한 방향으로 반경 0.5미터에 목표 Q 생성">
        Q<sub>s</sub> = A + 0.5 · R(s · 75°) · <span class="turtle-fraction"><span>A − G</span><span>‖A − G‖</span></span>
      </p>
      <p>A: 동물 위치 · G: 출구 · s: +1 또는 −1 · R: 평면 회전<br />계산 후 fence 안쪽으로 좌표를 제한합니다.</p>
    </div>
    <p class="turtle-boundary">출구 방향의 목표 생성 기하를 구현한 단계입니다. 도식의 점선은 배정 관계이며, 실제 주행 궤적이나 야생동물의 반응을 측정한 결과가 아닙니다.</p>
  </section>

  <section class="turtle-section page-shell" id="mission" aria-labelledby="mission-title">
    <div class="turtle-section__header">
      <p class="turtle-label">04 / Mission execution</p>
      <div>
        <h2 id="mission-title">계산한 목표를<br />주행·복귀 상태로 연결하기</h2>
        <p>목표 생성 노드와 로봇별 실행 노드를 나누고, 각 로봇이 Nav2 action의 수락·완료 결과에 따라 상태를 바꾸도록 구성했습니다. 미션 완료 신호를 받으면 지정된 복귀 위치로 이동한 뒤 도킹을 요청합니다.</p>
      </div>
    </div>
    <ol class="turtle-mission turtle-section__body" aria-label="출동부터 복귀와 도킹까지의 개념 흐름">
      {mission.map(([number, title, note]) => (
        <li><span>{number}</span><strong>{title}</strong><small>{note}</small></li>
      ))}
    </ol>
    <p class="turtle-boundary">미션 완료는 마지막 목표 좌표가 fence 밖에서 0.5초 경과한 경우로 판단합니다. 주행 목표 도달과는 별도이며, 특정 출구 통과나 충전 시작을 모두 검증하는 조건은 아닙니다.</p>
    <div class="turtle-async">
      <div class="turtle-async__heading">
        <p class="turtle-label">Asynchronous action</p>
        <h3>늦게 도착한 이전 결과가<br />새 목표의 상태를 바꾸지 않도록</h3>
      </div>
      <ol class="turtle-async__steps" aria-label="이전 주행 결과를 무시하는 순서">
        <li><span>t₀</span><strong>Goal n 전송</strong><small>callback에 seq = n 저장</small></li>
        <li><span>t₁</span><strong>Goal n+1로 갱신</strong><small>현재 _nav_seq = n+1</small></li>
        <li><span>t₂</span><strong>늦은 n 결과 도착</strong><small>순번 불일치 → 결과 무시</small></li>
      </ol>
      <p>새 목표가 전달된 뒤 늦게 도착한 이전 결과는 <code>_nav_seq</code> 순번을 비교해 무시합니다. 복귀·도킹 실패에는 횟수 제한과 지수 backoff를 둡니다.</p>
    </div>
    <details class="turtle-details">
      <summary>미션 상태·재시도·근접 분기 전체 도식</summary>
      <div class="turtle-details__body">
        <figure class="turtle-evidence">
          <div class="turtle-diagram-scroll" role="region" aria-label="미션 상세 도식, 작은 화면에서 가로 스크롤" tabindex="0">
            <img src={asset('mission-flow.svg')}
              alt="출동, Nav2 실행, 완료 판정, 복귀와 도킹, 이전 결과 무시 및 근접 정지 분기를 설명하는 코드 기반 도식"
              width="1440" height="1130" loading="lazy" decoding="async" />
          </div>
          <figcaption><span>Code-derived state flow</span><a href={asset('mission-flow.svg')} target="_blank" rel="noopener">도식 크게 보기 ↗</a></figcaption>
        </figure>
      </div>
    </details>
  </section>

  <section class="turtle-section page-shell" id="troubleshooting" aria-labelledby="troubleshooting-title">
    <div class="turtle-section__header">
      <p class="turtle-label">05 / Troubleshooting</p>
      <div>
        <h2 id="troubleshooting-title">두 로봇이 가까워졌을 때의 실행 제어</h2>
        <p>실기기 시험에서 두 로봇이 충분히 분리되지 않고 근접하는 장면이 발생했습니다. 독립적으로 목표를 수행하는 두 로봇 사이에 상대 위치를 반영한 추가 조정이 필요했습니다.</p>
      </div>
    </div>
    <div class="turtle-troubleshooting turtle-section__body">
      <figure class="turtle-evidence turtle-proximity">
        <ProjectVideo src={asset('robot-proximity.mp4')} poster={asset('robot-proximity-poster.webp')}
          width={514} height={684} label="서로 가까워진 두 TurtleBot4가 접촉 상태로 움직이는 실내 시험의 문제 장면" />
        <figcaption><span>실제 근접 문제 사례</span><span>발표자료 S20 · 4.7 s</span></figcaption>
      </figure>
      <div>
        <dl class="turtle-findings">
          <div><dt>Observed / 관찰</dt><dd>발표자료의 영상에 두 로봇이 근접·접촉한 채 움직이는 장면이 남아 있습니다.</dd></div>
          <div><dt>Hypothesis / 원인 가설</dt><dd>팀은 경로 중첩과 이동 우선권 문제를 원인으로 설명했습니다. 당시 원시 로그와 수정 전 버전이 없어 유일한 원인으로 확정할 수는 없습니다.</dd></div>
          <div><dt>Response / 코드의 대응</dt><dd>두 로봇의 위치를 공유하고, 거리 0.5 m 미만에서 Nav2 goal 취소를 요청하는 <code>SAFE_STOP</code>을 둡니다. 목표에 가까운 로봇의 예상 위치를 기준으로 다른 로봇의 목표점도 조정합니다.</dd></div>
          <div><dt>Validation / 검증 범위</dt><dd>문제 장면과 대응 코드의 존재를 확인했습니다. 동일 조건의 수정 전후 반복시험은 남아 있지 않으며, 재출발 조건과 별도 우회 상태의 연결에는 추가 검증이 필요합니다.</dd></div>
        </dl>
        <p class="turtle-boundary">현재 코드는 양쪽 로봇 모두 기본 0.1초 대기 후 거리 회복 조건 없이 재출발합니다. 발표의 High / Low 순차 출발 설명과 차이가 있습니다.</p>
