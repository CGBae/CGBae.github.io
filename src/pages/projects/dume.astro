---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectHero from '@/components/ProjectHero.astro';
import ProjectVideo from '@/components/ProjectVideo.astro';
import ProjectCodeLinks from '@/components/ProjectCodeLinks.astro';
import { projectBySlug } from '@/data/projects';
import sources from '@/data/project-sources.json';
import { withBase } from '@/utils/paths';
import '@/styles/case-study.css';
const project = projectBySlug.dume;
const source = sources.dume;
const asset = (file: string) => withBase('/projects/dume/' + file);
---
<BaseLayout title="DUM-E · VLM 조립 검사와 로봇 스킬 연동 — Bae Cheolgyu" description={project.description} bodyClass="project-page case-study">
  <ProjectHero project={project} titleLines={['DUM-E']}
    tagline="조립 상태를 살피고, 필요한 로봇 동작으로 연결하다"
    intro="현재 작업 단계와 카메라 관찰을 연결하는 조립 보조 시스템입니다. 조립 지원 인터페이스, VLM 기반 조립 검증과 로봇 스킬 연동을 담당했습니다."
    contributions={['조립 지원 인터페이스 연동', 'VLM 기반 조립 검증', '로봇 검사·도구 전달 스킬 연동']}
    team="4인 팀" platform="Doosan M0609 · RG2 · RealSense · ROS2" repository={source.repository}
    sections={[{href:'#assessment',label:'VLM 검사 구성'},{href:'#robot-context',label:'로봇 스킬 연동'},{href:'#troubleshooting',label:'문맥 전달 문제 해결'},{href:'#results',label:'결과'}]}>
    <figure class="case-figure">
      <ProjectVideo src={asset('demo-highlight.mp4')} poster={asset('demo-highlight-poster.webp')}
        captions={asset('demo-highlight.ko.vtt')} width={1920} height={1080} autoplay={true} loop={false}
        label="작업 단계 확인, 조립 위치 검사, 도구 집기와 손 전달을 보여주는 DUM-E 팀 시연" />
      <figcaption><span>조립 검사 · 도구 집기와 전달</span><span>실제 장비 · 44초 하이라이트 · 원본 속도</span></figcaption>
      <p class="case-note">시연은 당시 8단계 매뉴얼을 사용합니다. 아래 코드 설명은 현재 5단계 매뉴얼 기준이며, 자막은 장면 설명입니다. <a class="text-link" href="#full-demo">전체 시연 보기 ↓</a></p>
    </figure>
  </ProjectHero>

  <section class="case-section page-shell" id="assessment" aria-labelledby="assessment-title">
    <span id="question" class="case-anchor"></span>
    <header class="case-heading">
      <p class="case-label">01 / VLM inspection</p>
      <div><h2 id="assessment-title">사진에 ‘지금 검사할 기준’을 함께 전달했습니다</h2><p>같은 조립 사진도 현재 작업 단계에 따라 확인할 항목이 다릅니다. VLM 검사에서는 작업 단계와 기준 이미지를 관찰 사진에 연결하고, 결과를 항목별로 해석할 수 있는 입력·판정 흐름을 구성했습니다.</p></div>
    </header>
    <ol class="case-steps" aria-label="조립 평가에 전달하는 세 가지 입력">
      <li><strong>현재 작업 단계</strong><p>Tracker가 가리키는 단계의 설명과 완료 기준을 사용합니다. 일반 대화의 추측으로 현재 진도를 정하지 않습니다.</p></li>
      <li><strong>매뉴얼의 기준 이미지</strong><p>해당 단계와 연결된 페이지 이미지를 선택해 어떤 조립 상태를 확인할지 제공합니다.</p></li>
      <li><strong>카메라 관찰</strong><p>최근 프레임 또는 로봇 근접 검사에서 얻은 사진을 기준과 함께 전달합니다. 관찰 획득 경로에 따라 후속 처리는 다릅니다.</p></li>
    </ol>
    <div class="case-grid">
      <div class="case-copy">
        <h3>판정과 작업 진도를 구분한 이유</h3>
        <p>“완료로 저장해”라는 사용자 확인과 카메라로 확인한 결과를 같은 사실로 취급하면, 관찰하지 않은 상태가 검증 완료로 기록될 수 있습니다. 팀의 상태 관리 구조를 검사 흐름에 연결하면서 완료 출처를 구분했습니다.</p>
        <dl class="case-facts">
          <div><dt>조립 화면에서 평가</dt><dd>대표 프레임 3장과 기준 이미지로 구조화된 평가를 만듭니다. 필수 조건·오류·unknown과 완료 의도를 검사하고, 기본 2회의 연속 동일 판정 조건을 적용합니다.</dd></div>
          <div><dt>로봇 이동 후 근접 검사</dt><dd>현재 단계 기준과 로봇이 촬영한 사진을 비교해 검사 feedback을 반환합니다. 조립 화면 평가의 검증·진도 반영 절차가 모두 연결되어 있는 경로는 아닙니다.</dd></div>
        </dl>
      </div>
      <figure class="case-figure">
        <img src={asset('inspection-detail.webp')} width="950" height="475" loading="lazy" decoding="async" alt="실제 로봇 카메라가 촬영한 모터 조립체의 근접 화면" />
        <figcaption><span>팀 시연에서 얻은 실제 근접 관찰</span><a href={asset('inspection-detail.webp')} target="_blank" rel="noopener">확대 ↗</a></figcaption>
        <p class="case-note">위 이미지는 관찰 화면입니다. 평가 정확도를 측정한 데이터셋이나 완성된 자동 진도 갱신의 증거는 아닙니다.</p>
      </figure>
    </div>
    <ProjectCodeLinks links={[source.links.assessor,source.links.validator,source.links.state]} />
    <details class="case-details" id="task-state">
      <summary>평가 조건과 완료 출처 관리의 상세 구조</summary>
      <div class="case-details__body">
        <div class="case-diagram" tabindex="0" role="region" aria-label="조립 화면의 평가와 상태 반영 상세 구조"><img src={asset('assessment-state.svg')} width="1600" height="1050" loading="lazy" alt="작업 기준과 사진으로 평가를 만들고 조건 검사 후 상태를 갱신하거나 보류하는 조립 화면 평가 경로" /></div>
        <p>도해의 A경로는 ‘조립 화면에서 평가’, B경로는 ‘로봇 이동 후 근접 검사’입니다. 한 요청의 프레임 3장과 연속 판정 2회는 서로 다른 조건입니다. 설명 요청 자체를 완료 명령으로 처리하지 않습니다.</p>
        <p>사용자 선언은 user_confirmed, 관찰 평가에 따른 완료는 별도 출처로 기록합니다. complete_through는 앞 단계도 완료 목록에 포함하므로 각 이전 단계를 독립 촬영해 검증했다는 뜻은 아닙니다.</p>
      </div>
    </details>
  </section>

  <section class="case-section page-shell" id="robot-context" aria-labelledby="robot-title">
    <header class="case-heading">
      <p class="case-label">02 / Skill integration</p>
      <div><h2 id="robot-title">검사 요청과 로봇 실행 사이의 인터페이스를 연결했습니다</h2><p>제가 맡은 스킬 연동은 조립 지원 화면의 요청을 등록된 검사·도구 전달 기능과 연결하는 부분입니다. 작업 단계는 검사 문맥으로 전달하고, 실제 이동·파지 제어는 팀의 로봇 계층과 연동했습니다.</p></div>
    </header>
    <div class="case-grid case-grid--visual">
      <div class="case-copy">
        <dl class="case-facts">
          <div><dt>요청 → 등록 스킬</dt><dd>검사 의도를 InspectStepSkill과 같은 허용된 기능으로 연결합니다.</dd></div>
          <div><dt>스킬 → ROS2 → 로봇 앱</dt><dd>메시지로 실행 요청을 전달하고 로봇 계층에서 관찰 위치 이동·촬영을 수행합니다.</dd></div>
          <div><dt>관찰 + 현재 문맥 → 검사 결과</dt><dd>현재 단계 설명·기준 이미지와 사진을 함께 사용해 검사 feedback을 반환합니다.</dd></div>
        </dl>
        <p>도구 전달은 가리키기·기존 표적 선택 상태를 사용합니다. LLM이 관절각이나 로봇 궤적을 직접 생성하는 구조는 아닙니다.</p>
      </div>
      <figure class="case-figure">
        <ProjectVideo src={asset('inspection-context.mp4')} poster={asset('inspection-context-poster.webp')}
          captions={asset('inspection-context.ko.vtt')} width={1920} height={1080}
          label="현재 단계 기준을 화면에서 확인하고 로봇이 검사 위치로 이동해 촬영하는 팀 시연" />
        <figcaption><span>현재 단계 기준 확인 → 로봇 관찰 획득</span><span>37초 발췌 · 무음</span></figcaption>
        <p class="case-note case-boundary">영상의 단계 표시는 4/8을 유지합니다. 현재 로봇 검사 결과의 후속 상태 전달이 완결되지 않아, 검사 후 자동 다음 단계 전환은 구현 완료로 표시하지 않습니다.</p>
      </figure>
    </div>
    <ProjectCodeLinks links={[source.links.inspect,source.links.bridge,source.links.context]} />
    <details class="case-details">
      <summary>요청부터 도구 전달까지의 추가 시연</summary>
      <div class="case-details__body">
        <figure class="case-figure"><ProjectVideo src={asset('context-fetch.mp4')} poster={asset('context-fetch-poster.webp')} captions={asset('context-fetch.ko.vtt')} width={1920} height={1080} loop={false} label="5/8 단계 화면에서 가리킨 해머를 요청하고 로봇이 집어 손으로 전달하는 시연" /><figcaption>34.6초 연속 구간 · 검사 영상과 별도 세션 · 요청·로봇 화면 동시 표시</figcaption></figure>
        <div class="case-diagram" tabindex="0" role="region" aria-label="로봇 검사 요청과 작업 기준 연결 구조"><img src={asset('robot-inspection.svg')} width="1600" height="1120" loading="lazy" alt="등록 스킬에서 로봇 촬영으로 이어지고 live tracker의 현재 단계 기준을 검사 입력에 연결하는 구조" /></div>
      </div>
    </details>
  </section>

  <section class="case-section page-shell" id="troubleshooting" aria-labelledby="trouble-title">
    <header class="case-heading">
      <p class="case-label">03 / Context mismatch</p>
      <div><h2 id="trouble-title">사진은 도착했는데,<br />검사할 단계가 전달되지 않았습니다</h2><p>검사 스킬은 current_step()으로 현재 작업 기준을 요청하지만, 정적 매뉴얼 객체는 전체 단계 목록만 가지고 있었습니다. 검사 입력에 필요한 인터페이스와 데이터를 가진 객체가 맞지 않는 문제였습니다.</p></div>
    </header>
    <div class="case-comparison">
      <div><p class="case-label">문제 / 정적 매뉴얼</p><h3>전체 목록은 있지만 현재 단계가 없음</h3><p>검사 시점의 작업 포인터를 제공하지 못해 모델 입력에서 현재 단계 기준이 누락됩니다.</p></div>
      <div><p class="case-label">연결 / Live tracker 어댑터</p><h3>호출할 때마다 현재 기준을 읽음</h3><p>TrackerStepContext가 같은 tracker를 참조하며 현재 단계의 설명과 reference를 검사 스킬에 전달합니다.</p></div>
    </div>
    <div class="case-grid">
      <div class="case-copy"><h3>연결 구조에서 확인한 변화</h3><p>보존된 오프라인 재현 기록에서는 같은 어댑터가 단계 변경에 따라 step_01 / page_005에서 step_04 / page_009로 참조를 바꿨습니다. 데이터 소유권은 tracker에 두고, 검사 스킬에는 필요한 인터페이스를 제공하는 구조입니다.</p></div>
      <div class="case-copy"><h3>남아 있는 연결 과제</h3><p>completion 조건을 dict 대신 속성으로 읽어 일부 문자열이 누락되는 문제가 남아 있습니다. 또한 검사 feedback의 판정을 최종 결과·진도 갱신까지 전달하는 경로를 보완해야 합니다.</p></div>
    </div>
    <ProjectCodeLinks links={[source.links.context,source.links.inspect]} />
    <details class="case-details" id="manual-grounding">
      <summary>검사의 배경이 되는 매뉴얼·작업 상태 구조</summary>
      <div class="case-details__body">
        <div class="case-grid">
          <div class="case-copy"><h3>팀 시스템의 매뉴얼 준비</h3><p>PDF를 단계 설명·부품·도구·시각 조건으로 구조화하고 기준 페이지 이미지를 연결합니다. 현재 단계와 질문 의도에 따라 필요한 기준을 선택하는 규칙 기반 처리입니다.</p><p>현재 package는 5단계의 검수 전 초안입니다. 벡터 검색이나 답변별 자동 출처 인용을 구현한 RAG로 소개하지 않습니다. 제가 담당한 검사는 이 기준과 작업 상태를 입력으로 사용하는 부분입니다.</p></div>
          <figure class="case-figure case-figure--document"><img src={asset('manual-page-009.webp')} width="1136" height="1751" loading="lazy" alt="현재 step_04에 연결된 매뉴얼 9페이지" /><figcaption><span>현재 step_04의 기준 페이지</span><a href={asset('manual-page-009.webp')} target="_blank" rel="noopener">원본 크기 ↗</a></figcaption></figure>
        </div>
        <div class="case-diagram" tabindex="0" role="region" aria-label="현재 단계 어댑터의 연결과 남은 문제"><img src={asset('step-context-fix.svg')} width="1600" height="1080" loading="lazy" alt="정적 매뉴얼의 인터페이스 불일치와 live tracker 연결, 완료 조건 전달 누락을 정리한 도해" /></div>
      </div>
    </details>
  </section>

  <section class="case-result" id="results" aria-labelledby="result-title">
    <div class="page-shell">
      <p class="case-label">04 / Result</p><h2 id="result-title">VLM 검사와 로봇 동작을<br />조립 지원 흐름에 연결했습니다</h2>
      <p class="case-result__lead">현재 단계·기준 이미지·관찰 사진을 검사 입력으로 구성하고, 등록 스킬과 ROS2를 통해 로봇 계층에 연결했습니다. 팀 시연에서는 조립 위치 검사와 도구 집기·전달·회수를 수행했습니다.</p>
      <div class="case-result__grid">
        <div><h3>담당 구현에서 보여준 것</h3><p>검사에 필요한 문맥을 명시적인 데이터로 전달하고, 사용자 확인과 관찰 판정의 의미를 구분하며, 서로 다른 소프트웨어·로봇 인터페이스를 연결했습니다.</p></div>
        <div><h3>보완할 부분</h3><p>완료 조건의 누락, 검사 결과의 후속 상태 전달을 마무리해야 합니다. 다양한 제품·조명·가림 조건의 검사 정확도와 전체 요청 지연도 추가 측정 대상입니다.</p></div>
      </div>
    </div>
  </section>
  <section class="case-appendix page-shell" aria-label="전체 시연과 검증 근거">
    <details class="case-details" id="full-demo"><summary>전체 시연 · 112.53초</summary><div class="case-details__body">
      <figure class="case-figure"><ProjectVideo src={asset('demo-full.mp4')} poster={asset('demo-full-poster.webp')} captions={asset('demo-full.ko.vtt')} width={1920} height={1080} loop={false} label="조립 보조 화면, 검사, 도구 전달과 회수를 원본 순서대로 담은 DUM-E 전체 시연" /><figcaption>최종 발표 시연 · 무음 · 원본 영상 순서 유지</figcaption></figure>
    </div></details>
    <details class="case-details" id="sources"><summary>구현 버전과 검증 범위</summary><div class="case-details__body">
      <p>구현 설명은 연결된 코드 버전과 현재 보존된 5단계 매뉴얼 기준입니다. 영상은 8단계 시연이며 같은 빌드와 동일한 조건이라는 근거는 없습니다. 오프라인 상태·어댑터 확인은 실제 API·로봇을 실행한 시험과 구분합니다.</p>
      <p>로봇 근접 검사에는 조립 화면 평가의 validator·연속 판정 절차가 모두 연결되어 있지 않습니다. 완료 조건 전달과 자동 진도 갱신의 미완성 부분을 해결한 뒤 전체 흐름을 검증해야 합니다.</p>
    </div></details>
  </section>
  <nav class="next-project page-shell" aria-label="다음 프로젝트"><a href={withBase('/projects/palpa/')}><span>Next project / 04</span><strong>PALPA</strong></a></nav>
</BaseLayout>
