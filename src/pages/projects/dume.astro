---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectVideo from '@/components/ProjectVideo.astro';
import ProjectContribution from '@/components/ProjectContribution.astro';
import { projectBySlug } from '@/data/projects';
import { withBase } from '@/utils/paths';
import '@/styles/dume.css';

const project = projectBySlug.dume;
const asset = (name: string) => withBase('/projects/dume/' + name);
const inputs = [
  ['01', '현재 작업 단계', 'Tracker의 작업 포인터와 완료 출처'],
  ['02', '매뉴얼의 기준', '단계 설명·시각 조건·기준 페이지'],
  ['03', '카메라의 관찰', '현재 조립 사진 또는 로봇 검사 사진'],
];
const manualSteps = [
  ['01', 'PDF 구조화', '단계 설명 · 부품 · 도구 · 시각 조건'],
  ['02', '참조 검사', 'ID · 순서 · 부품 참조 · 페이지 범위'],
  ['03', '매뉴얼 package', 'YAML · 페이지 이미지 · 검수 초안'],
  ['04', '작업 기준 선택', '질문 의도 · 명시한 단계 · 현재 단계'],
];
const stateExamples = [
  ['단계 설명', '“4단계 설명해 줘”', '지정한 단계의 설명과 기준 이미지를 선택합니다.', '현재 포인터·완료 기록 유지'],
  ['사용자 완료', '“2단계까지 완료로 저장해”', '사용자가 선언한 진도를 완료 목록에 기록합니다.', 'user_confirmed · 시각 검증과 구분'],
  ['관찰 검증', '완료 의도가 있는 관찰 평가', '필수 조건과 연속 동일 판정을 확인한 뒤 반영합니다.', '허용 시 verified 경로로 갱신'],
];
const inspectionSteps = [
  ['01', '검사 요청', '등록된 InspectStepSkill'],
  ['02', '이동·촬영', 'ROS2 → 별도 로봇 앱'],
  ['03', '현재 기준 연결', 'Live tracker + reference'],
  ['04', '사진과 기준 비교', '검사 feedback 반환'],
];
const validation = [
  ['실제 시연', '조립 위치 검사, 도구 집기·손 전달·회수 동작을 실제 장비 영상에서 확인했습니다.', '8단계 매뉴얼을 사용한 시연 기록'],
  ['코드·오프라인 확인', '단계 기준 선택, 완료 출처 구분, live tracker 어댑터의 단계 변경 반영을 확인한 기록이 있습니다.', '현재 5단계 package · 부분 단위 검증'],
  ['남은 구현 연결', '완료 조건 일부의 전달과 로봇 검사 결과의 후속 상태 반영에 미완성 경계가 있습니다.', '전체 검사 후 자동 진도 갱신은 미확인'],
  ['미검증 범위', '임의 매뉴얼의 검사 정확도, 음성·응답 지연, 장시간 운용과 전체 테스트 통과는 확인되지 않았습니다.', '연구·교육용 통합 prototype'],
];
---

<BaseLayout
  title="DUM-E · Assembly Assistance — Bae Cheolgyu"
  description={project.description}
  bodyClass="project-page project-page--dume"
>
  <section class="dume-hero page-shell" id="demo" aria-labelledby="dume-title">
    <header class="dume-hero__copy">
      <p class="eyebrow">03 / DUM-E · Assembly Assistance</p>
      <h1 id="dume-title"><span>Task Context</span><span>to Robot Action</span></h1>
      <div class="dume-hero__intro">
        <p class="dume-hero__subtitle">조립의 다음 판단에, 현재 작업의 근거를 연결하다</p>
        <p class="dume-hero__lead">작업 중인 단계를 확인하고, 조립 상태를 살펴보고, 필요한 도구를 전달받습니다. DUM-E는 매뉴얼·작업 상태·로봇 관찰을 연결해 조립 중의 질문과 요청을 돕는 시스템입니다.</p>
        <ul class="dume-keywords" aria-label="핵심 기술">
          <li>Python</li><li>Task State</li><li>Multimodal Inspection</li>
          <li>Structured Output</li><li>ROS2</li><li>SQLite</li>
        </ul>
      </div>
      <dl class="dume-role">
        <div><dt>Team project</dt><dd>조립 검사·도구 전달<br />4인 로봇 작업 보조 프로젝트</dd></div>
        <div><dt>Platform</dt><dd>Doosan M0609 · RG2<br />RealSense · ROS2</dd></div>
        <div><dt>Project period</dt><dd>{project.period}</dd></div>
      </dl>
    </header>
    <ProjectContribution role={project.role} />
    <figure class="dume-evidence dume-hero__demo">
      <ProjectVideo src={asset('demo-highlight.mp4')} poster={asset('demo-highlight-poster.webp')}
        captions={asset('demo-highlight.ko.vtt')} width={1920} height={1080} autoplay={true}
        label="조립 단계 확인, 지시 위치 검사와 도구 집기·손 전달을 보여주는 DUM-E 시연 하이라이트" />
      <figcaption><span>조립 검사와 도구 전달 · 44초 하이라이트</span><span>발췌 편집 · 무음 · 원본 속도 유지</span></figcaption>
    </figure>
    <div class="dume-demo-footer">
      <p class="dume-note">시연은 당시의 <strong>8단계 매뉴얼</strong>을 사용합니다. 아래 구현 설명은 현재 저장소의 <strong>5단계 매뉴얼</strong>을 기준으로 합니다. 영상 자막은 음성 전사가 아닌 장면 설명입니다.</p>
      <div class="dume-links">
        <a class="text-link" href={asset('demo-full.mp4')} target="_blank" rel="noopener">전체 시연 보기 <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#results">구현과 검증 범위 <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="dume-section page-shell" id="question" aria-labelledby="question-title">
    <div class="dume-section__header">
      <p class="dume-label">01 / Engineering question</p>
      <div>
        <h2 id="question-title">같은 사진도,<br />현재 단계에 따라 판단 기준이 달라집니다</h2>
        <p>조립 상태를 묻는 질문에 답하려면 사진뿐 아니라 지금 수행 중인 작업과 매뉴얼의 기준이 필요했습니다. DUM-E는 이 정보를 명시적인 단계 데이터와 작업 상태로 관리하고, 검사에 필요한 문맥을 구성했습니다.</p>
      </div>
    </div>
    <ol class="dume-inputs" aria-label="조립 판단에 필요한 세 가지 입력">
      {inputs.map(([number, title, note]) => (
        <li><span>{number}</span><strong>{title}</strong><small>{note}</small></li>
      ))}
    </ol>
    <p class="dume-note">아래 구현 설명은 매뉴얼 처리·작업 상태·시각 검사·로봇 제어를 연결한 팀 시스템을 기준으로 합니다.</p>
  </section>

  <!-- Manual grounding -->
  <section class="dume-section page-shell" id="manual-grounding" aria-labelledby="manual-title">
    <div class="dume-section__header">
      <p class="dume-label">02 / Manual grounding</p>
      <div>
        <h2 id="manual-title">매뉴얼을<br />단계별 작업 기준으로</h2>
        <p>PDF에서 단계 설명, 부품·도구, 시각 조건과 근거 페이지를 구조화하고 페이지 이미지를 연결했습니다. 질문 의도와 현재 단계에 따라 필요한 데이터를 선택해 안내와 검사에 사용합니다.</p>
      </div>
    </div>
    <div class="dume-manual dume-section__body">
      <figure class="dume-evidence dume-manual__page">
        <a href={asset('manual-page-009.webp')} target="_blank" rel="noopener" aria-label="현재 step_04의 매뉴얼 9페이지 원본 크기로 보기">
          <img src={asset('manual-page-009.webp')} alt="타이밍 벨트 연결·텐션 조정·최종 고정 내용이 보존된 매뉴얼 9페이지 전체"
            width="1136" height="1751" loading="lazy" decoding="async" />
        </a>
        <figcaption><span>현재 step_04 · PDF page 9</span><a href={asset('manual-page-009.webp')} target="_blank" rel="noopener">페이지 확대 ↗</a></figcaption>
      </figure>
      <div class="dume-manual__reference">
        <dl class="dume-reference-data">
          <div><dt>Step</dt><dd><code>step_04</code> · 타이밍 벨트 연결·텐션 조정·최종 고정</dd></div>
          <div><dt>Reference</dt><dd>보존된 PDF 9페이지 · <code>page_009.jpg</code></dd></div>
          <div><dt>Package</dt><dd>현재 5단계 매뉴얼 · 사람 검수 전 초안</dd></div>
        </dl>
        <figure class="dume-evidence">
          <img src={asset('manual-step04-detail.webp')} alt="같은 매뉴얼 9페이지에서 벨트 연결과 최종 체결 사진 영역을 확대한 이미지"
            width="1136" height="954" loading="lazy" decoding="async" />
          <figcaption><span>현재 단계의 기준 사진</span><span>동일 페이지의 사진 영역 확대</span></figcaption>
        </figure>
      </div>
    </div>
    <ol class="dume-process" aria-label="매뉴얼 준비와 작업 기준 선택 과정">
      {manualSteps.map(([number, title, note]) => (
        <li><span>{number}</span><strong>{title}</strong><small>{note}</small></li>
      ))}
    </ol>
    <p class="dume-boundary">생성된 매뉴얼은 사람 검수 전 초안입니다. 단계 선택은 규칙 기반이며, 벡터 검색이나 답변별 자동 출처 인용은 구현하지 않았습니다.</p>
    <details class="dume-details">
      <summary>매뉴얼 준비와 런타임 선택 도해</summary>
      <div class="dume-details__body">
        <figure class="dume-evidence">
          <div class="dume-diagram-scroll" role="region" aria-label="매뉴얼 처리 도해, 작은 화면에서 가로 스크롤" tabindex="0">
            <img src={asset('manual-context.svg')} alt="전체 PDF 구조화와 참조 검사로 package를 만들고 현재 작업에 필요한 기준을 선택하는 흐름"
              width="1600" height="1000" loading="lazy" decoding="async" />
          </div>
          <figcaption><span>Code-derived diagram · 실행 화면 아님</span><a href={asset('manual-context.svg')} target="_blank" rel="noopener">도해 크게 보기 ↗</a></figcaption>
        </figure>
      </div>
    </details>
  </section>

  <!-- Task state -->
  <section class="dume-section page-shell" id="task-state" aria-labelledby="state-title">
    <div class="dume-section__header">
      <p class="dume-label">03 / Assembly task state</p>
      <div>
        <h2 id="state-title">작업자가 확인한 진도와<br />카메라가 검증한 상태를 구분했습니다</h2>
        <p>현재 단계와 완료 목록을 관리하면서 사용자 확인과 시각 관찰의 출처를 별도로 기록했습니다. 단계 설명을 요청하는 일과 완료로 저장하는 일을 나누고, 조립 평가 경로에서는 항목별 근거와 판정 조건을 확인한 뒤 상태를 반영합니다.</p>
      </div>
    </div>
    <div class="dume-state-examples dume-section__body">
      <p class="dume-label">Code behavior examples · 실제 대화 로그 아님</p>
      <dl>
        {stateExamples.map(([kind, request, response, state]) => (
          <div><dt><span>{kind}</span><strong>{request}</strong></dt><dd><p>{response}</p><small>{state}</small></dd></div>
        ))}
      </dl>
    </div>
    <div class="dume-assessment">
      <div>
        <p class="dume-label">Assessment / A path</p>
        <h3>관찰 결과를<br />상태에 반영하기까지</h3>
        <p>최근 대표 프레임 3장과 단계별 기준 이미지로 구조화된 평가를 만듭니다. 필수 조건·오류·가림·unknown을 검사하고, 허용된 완료 의도에서 연속 동일 판정 기본 2회를 확인합니다.</p>
      </div>
      <ol class="dume-rules" aria-label="조립 엔진 A경로의 상태 반영 조건">
        <li><span>01</span><div><h4>항목별 근거 확인</h4><p>required 조건과 오류·unknown을 검사합니다.</p></div></li>
        <li><span>02</span><div><h4>완료 의도와 판정 조건</h4><p>확인 질문 자체를 완료 명령으로 해석하지 않습니다.</p></div></li>
        <li><span>03</span><div><h4>상태 갱신 또는 보류</h4><p>허용되면 검증 출처를 기록하고, 불확실하면 진도를 보류합니다.</p></div></li>
      </ol>
    </div>
    <p class="dume-boundary">이 조건은 조립 엔진의 A경로에 적용됩니다. 한 요청의 이미지 3장과 연속 판정 2회는 별개이며, 로봇 이동 후 검사하는 B경로에는 같은 검증 절차가 모두 연결되어 있지 않습니다.</p>
    <details class="dume-details">
      <summary>상태 출처와 조립 평가 경로 도해</summary>
      <div class="dume-details__body">
        <figure class="dume-evidence">
          <div class="dume-diagram-scroll" role="region" aria-label="상태 출처 구분 도해, 작은 화면에서 가로 스크롤" tabindex="0">
            <img src={asset('task-state-provenance.svg')} alt="단계 설명, 사용자 완료와 관찰 검증의 처리 및 상태 출처를 구분한 코드 동작 예시"
              width="1600" height="1020" loading="lazy" decoding="async" />
          </div>
          <figcaption><span>State provenance · 코드 동작 예시</span><a href={asset('task-state-provenance.svg')} target="_blank" rel="noopener">도해 크게 보기 ↗</a></figcaption>
        </figure>
        <figure class="dume-evidence">
          <div class="dume-diagram-scroll" role="region" aria-label="조립 엔진 평가 도해, 작은 화면에서 가로 스크롤" tabindex="0">
            <img src={asset('assessment-state.svg')} alt="작업 문맥과 사진으로 VLM 평가를 만들고 조건 검사 후 상태를 갱신하거나 보류하는 A경로"
              width="1600" height="1050" loading="lazy" decoding="async" />
          </div>
          <figcaption><span>Assessment route · A경로 한정</span><a href={asset('assessment-state.svg')} target="_blank" rel="noopener">도해 크게 보기 ↗</a></figcaption>
        </figure>
        <p><code>complete_through</code>는 앞선 단계들을 함께 완료 목록에 포함합니다. 각 이전 단계를 별도로 촬영해 검증했다는 의미는 아닙니다.</p>
      </div>
    </details>
  </section>

  <!-- Robot context -->
  <section class="dume-section page-shell" id="robot-context" aria-labelledby="robot-title">
    <div class="dume-section__header">
      <p class="dume-label">04 / Robot inspection context</p>
      <div>
        <h2 id="robot-title">로봇이 촬영한 사진에,<br />지금 검사할 작업을 함께 전달했습니다</h2>
        <p>로봇 검사에는 호출 시점의 작업 단계와 기준 이미지를 전달하도록 구성했습니다. 자연어 요청은 등록된 스킬과 ROS2 메시지로 이어지고, 실제 이동·파지 제어는 로봇 계층이 수행합니다.</p>
      </div>
    </div>
    <figure class="dume-evidence dume-section__body">
      <ProjectVideo src={asset('inspection-context.mp4')} poster={asset('inspection-context-poster.webp')}
        captions={asset('inspection-context.ko.vtt')} width={1920} height={1080}
        label="시연 당시 4/8 단계 기준 화면을 확인한 뒤 로봇 카메라가 조립 위치로 이동해 촬영하는 장면" />
      <figcaption><span>현재 작업 기준 확인 → 로봇 관찰 획득</span><span>V12 · 37초 발췌 · 시연 당시 4/8 유지</span></figcaption>
    </figure>
    <ol class="dume-process" aria-label="로봇 검사 B경로의 실행과 문맥 연결">
      {inspectionSteps.map(([number, title, note]) => (
        <li><span>{number}</span><strong>{title}</strong><small>{note}</small></li>
      ))}
    </ol>
    <p class="dume-boundary">B경로의 검사 feedback은 A경로의 validator·연속 판정 조건과 별도입니다. 현재 코드에는 결과의 후속 상태 전달이 남아 있어, 이 영상을 자동 4→5단계 전환의 근거로 사용하지 않습니다.</p>
    <details class="dume-details">
      <summary>로봇 검사 context 도해와 실제 카메라 관찰</summary>
      <div class="dume-details__body">
        <figure class="dume-evidence">
          <div class="dume-diagram-scroll" role="region" aria-label="로봇 검사 B경로 도해, 작은 화면에서 가로 스크롤" tabindex="0">
            <img src={asset('robot-inspection.svg')} alt="등록 스킬에서 로봇 촬영으로 이어지는 관찰 경로와 live tracker의 단계 기준이 검사 입력에서 만나는 구조"
              width="1600" height="1120" loading="lazy" decoding="async" />
          </div>
          <figcaption><span>Robot inspection · B경로</span><a href={asset('robot-inspection.svg')} target="_blank" rel="noopener">도해 크게 보기 ↗</a></figcaption>
        </figure>
        <figure class="dume-evidence dume-inspection-detail">
          <img src={asset('inspection-detail.webp')} alt="실제 로봇 카메라가 촬영한 모터 조립체의 근접 화면" width="950" height="475" loading="lazy" decoding="async" />
