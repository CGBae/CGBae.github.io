---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectVideo from '@/components/ProjectVideo.astro';
import ProjectContribution from '@/components/ProjectContribution.astro';
import { projectBySlug } from '@/data/projects';
import { withBase } from '@/utils/paths';
import '@/styles/automatic-fueling.css';

const project = projectBySlug['automatic-fueling'];
const asset = (name: string) => withBase('/projects/automatic-fueling-robot/' + name);
const stages = [
  ['Far', '+0.28 m', '0.18 m/s'],
  ['Mid', '+0.18 m', '0.18 m/s'],
  ['Near', '+0.09 m', '0.12 m/s'],
  ['Insert', '−0.05 m', '0.06 m/s'],
];
const pipeline = [
  ['01', '마커 → 작업 목표점', 'ID 0의 pose에 door · cap · hole offset 적용'],
  ['02', '카메라 → world', '축 매핑 · 주유구 보정 · 기준 높이 · target lock'],
  ['03', '노즐 끝 → 로봇 명령', '접근점 생성 · link_6 offset · RMPFlow'],
];
---

<BaseLayout title="Automatic Fueling Robot · Vision Target to Robot Motion — Bae Cheolgyu"
  description={project.description} bodyClass="project-page project-page--automatic-fueling">
  <section class="fuel-hero page-shell" id="demo" aria-labelledby="fuel-title">
    <header class="fuel-hero__copy">
      <p class="eyebrow">02 / Automatic Fueling Robot · Simulation</p>
      <h1 id="fuel-title"><span>Vision Target</span><span>to Robot Motion</span></h1>
      <div class="fuel-hero__intro">
        <p class="fuel-hero__subtitle">ArUco 목표점에서 노즐 동작까지</p>
        <p class="fuel-hero__lead">카메라에서 얻은 목표점은 어떤 과정을 거쳐 노즐의 움직임이 될까요? 좌표 변환, 접근점 구성, 툴 오프셋과 RMPFlow를 연결해 자동 주유 동작을 시뮬레이션으로 구현했습니다.</p>
        <ul class="fuel-keywords" aria-label="핵심 기술">
          <li>ROS2</li><li>Isaac Sim · USD</li><li>OpenCV ArUco</li><li>Cartesian Waypoint</li><li>RMPFlow</li>
        </ul>
      </div>
      <dl class="fuel-meta">
        <div><dt>Team project</dt><dd>ALT F-4 · 4인 팀 <br />자동 주유 로봇 시뮬레이션</dd></div>
        <div><dt>Platform</dt><dd>두 M0609 로봇팔 <br />Isaac Sim · ROS2</dd></div>
        <div><dt>Project period</dt><dd>{project.period}</dd></div>
      </dl>
    </header>
    <ProjectContribution role={project.role} />
    <figure class="fuel-evidence fuel-hero__demo">
      <ProjectVideo src={asset('hero-nozzle-motion.mp4')} poster={asset('hero-nozzle-poster.webp')}
        width={938} height={504}
        label="최종 발표 시뮬레이션에서 차량 주유구 주변의 노즐이 유지된 뒤 후퇴하는 장면" />
      <figcaption><span>최종 발표 scene · 노즐 유지와 후퇴</span><span>6초 · 무음 · 재생 버튼으로 확인</span></figcaption>
    </figure>
    <nav class="fuel-jump-links" aria-label="프로젝트 주요 내용">
      <a class="text-link" href="#transformation">목표점 변환 과정 <span aria-hidden="true">↓</span></a>
      <a class="text-link" href="#approach">접근 경로와 툴 오프셋 <span aria-hidden="true">↓</span></a>
      <a class="text-link" href="#results">시연 결과 <span aria-hidden="true">↓</span></a>
    </nav>
  </section>

  <section class="fuel-section page-shell" id="transformation" aria-labelledby="transformation-title">
    <div class="fuel-section__header">
      <p class="fuel-label">01 / Target to motion</p>
      <div>
        <h2 id="transformation-title">카메라의 목표점을 <br />로봇의 위치 명령으로</h2>
        <p>마커를 검출한 뒤에도 작업 대상, 좌표계, 노즐 길이를 고려해야 합니다. 팀은 이 기준들을 순서대로 적용해 인식 결과를 로봇이 실행할 위치 명령으로 바꿨습니다.</p>
      </div>
    </div>
    <div class="fuel-split fuel-split--diagram">
      <ol class="fuel-process" aria-label="인식에서 로봇 명령까지의 세 단계">
        {pipeline.map(([number, title, detail]) => (
          <li><span>{number}</span><strong>{title}</strong><p>{detail}</p></li>
        ))}
      </ol>
      <figure class="fuel-evidence">
        <div class="fuel-diagram-scroll" tabindex="0" role="region" aria-label="목표점 변환 도해, 좁은 화면에서 좌우 스크롤">
          <img src={asset('pose-to-motion.svg')} width="1200" height="1080" loading="lazy" decoding="async"
            alt="ArUco 인식, mode offset과 평균, world 변환, mouth 보정과 Z 고정, gate와 lock, tip waypoint, link_6 목표, RMPFlow의 9단계. Lock 실패 시 USD reference로 대체." />
        </div>
        <figcaption><span>코드 기반 도해 · 기본 실행 경로</span><a href={asset('pose-to-motion.svg')} target="_blank" rel="noopener">도해 원본 보기 ↗</a></figcaption>
      </figure>
    </div>
    <p class="fuel-note">Detector가 발행하는 quaternion·direction은 기본 motion 제어에 사용하지 않습니다. 아래 경로는 확정한 목표점과 고정된 접근축을 기준으로 설명합니다.</p>
  </section>

  <section class="fuel-section page-shell" id="pose" aria-labelledby="pose-title">
    <div class="fuel-section__header">
      <p class="fuel-label">02 / Pose estimation</p>
      <div>
        <h2 id="pose-title">하나의 마커에서 <br />세 작업의 목표점으로</h2>
        <p>CameraInfo의 K/D와 ArUco ID 0의 회전·이동 값을 이용해 door·cap·hole 목표점을 계산했습니다. 마커 좌표계에 정의한 작업별 offset을 회전·이동한 위치입니다.</p>
      </div>
    </div>
    <div class="fuel-split">
      <div class="fuel-pose-copy">
        <p class="fuel-label">Marker frame → Camera frame</p>
        <p class="fuel-formula" aria-label="카메라 목표점은 마커 회전 행렬 곱하기 작업별 오프셋 더하기 마커 이동 벡터">
          p<sub>target</sub> = R · offset<sub>mode</sub> + t
        </p>
        <dl class="fuel-targets">
          <div><dt>Door</dt><dd>커버 작업의 기준점</dd></div>
          <div><dt>Cap</dt><dd>캡 작업의 기준점</dd></div>
          <div><dt>Hole</dt><dd>노즐 접근을 위한 주유구 입구</dd></div>
        </dl>
        <details class="fuel-details">
          <summary>마커 설정과 안정화 기준</summary>
          <div>
            <p><code>DICT_4X4_50 · ID 0 · 0.12 m</code></p>
            <p>최대 8개 sample 중 최소 3개부터 표준편차 norm ≤ 0.035 m인 첫 window를 lock합니다.</p>
            <dl class="fuel-offsets">
              <div><dt>Door</dt><dd>[0.227924, 0.259677, −0.028225]</dd></div>
              <div><dt>Cap</dt><dd>[0.230000, 0.240000, −0.051500]</dd></div>
              <div><dt>Hole</dt><dd>[0.230000, 0.290000, −0.051500]</dd></div>
            </dl>
            <p>Offset은 marker frame의 XYZ 값이며 단위는 m입니다.</p>
          </div>
        </details>
      </div>
      <figure class="fuel-evidence fuel-offset-evidence">
        <a class="fuel-image-link" href={asset('marker-offset-development.webp')} target="_blank" rel="noopener">
          <img src={asset('marker-offset-development.webp')} width="760" height="568" loading="lazy" decoding="async"
            alt="이전 mode=blue detector에서 목표 offset을 조정한 두 개발 화면. 서로 다른 시점의 기록." />
        </a>
        <figcaption><span>목표 offset 조정 과정 · 이전 detector 설정</span><a href={asset('marker-offset-development.webp')} target="_blank" rel="noopener">이미지 원본 보기 ↗</a></figcaption>
        <p class="fuel-caption-note">화면 속 mode=blue는 개발 당시 설정이며, 현재 실행 mode는 door / cap / hole입니다.</p>
      </figure>
    </div>
  </section>

  <section class="fuel-section page-shell" id="coordinate" aria-labelledby="coordinate-title">
    <div class="fuel-section__header">
      <p class="fuel-label">03 / Coordinate bridge</p>
      <div>
        <h2 id="coordinate-title">Scene 좌표와 기준 높이에 <br />맞춰 목표점을 확정하다</h2>
        <p>고정 camera 배치에 맞춰 축을 재배열하고 camera의 world 원점을 더했습니다. 주유구 입구에서 안쪽으로 0.05 m 보정하고 Z를 기준 높이에 고정한 뒤, gate와 sample 분산을 검사했습니다.</p>
      </div>
    </div>
    <div class="fuel-split fuel-split--diagram">
      <div>
        <p class="fuel-formula fuel-formula--small">p<sub>world</sub> = camera<sub>origin</sub> <br />+ [−x<sub>c</sub>, −z<sub>c</sub>, −y<sub>c</sub>]</p>
        <ol class="fuel-coordinate-steps">
          <li><strong>World 변환</strong><span>Camera 원점 + 수동 축 매핑</span></li>
          <li><strong>주유구 기준 보정</strong><span>Mouth → center · Z reference 고정</span></li>
          <li><strong>범위와 안정성 확인</strong><span>Workspace gate → 5개 유효 sample lock</span></li>
        </ol>
        <p class="fuel-note">고정 scene 전용 변환입니다. Z를 먼저 고정하므로 원래 카메라 높이 오차를 검증하는 과정은 아닙니다.</p>
        <details class="fuel-details">
          <summary>Lock 기준과 대체 경로</summary>
          <div>
            <p>Gate half-extent [0.35, 0.35, 0.18] m 안의 5개 유효 sample에서 표준편차 norm ≤ 0.025 m를 검사합니다.</p>
            <p>약 10초 안에 lock되지 않으면 USD 기준 좌표로 진행합니다. Full extrinsic transform이나 TF2는 사용하지 않습니다.</p>
          </div>
        </details>
      </div>
      <figure class="fuel-evidence">
        <div class="fuel-diagram-scroll" tabindex="0" role="region" aria-label="좌표 변환 도해, 좁은 화면에서 좌우 스크롤">
          <img src={asset('coordinate-transform.svg')} width="1200" height="1050" loading="lazy" decoding="async"
            alt="Camera 원점에 마이너스 x, 마이너스 z, 마이너스 y를 더하고, hole 안쪽 보정, Z reference 고정, gate와 5 sample 검사를 적용하는 순서." />
        </div>
        <figcaption><span>코드 기반 도해 · 좌표 변환과 lock 순서</span><a href={asset('coordinate-transform.svg')} target="_blank" rel="noopener">도해 원본 보기 ↗</a></figcaption>
      </figure>
    </div>
  </section>

  <section class="fuel-section page-shell" id="approach" aria-labelledby="approach-title">
    <div class="fuel-section__header">
      <p class="fuel-label">04 / Approach geometry</p>
      <div>
        <h2 id="approach-title">노즐 끝과 로봇 손목의 <br />목표점을 나누다</h2>
        <p>고정된 주유구 축에 접근·근접·삽입 목표점을 배치했습니다. 노즐 끝의 목표에 가상 노즐 길이와 높이 offset을 적용해 link_6가 도달할 위치를 계산했습니다.</p>
      </div>
    </div>
    <div class="fuel-split fuel-split--diagram">
      <div>
        <p class="fuel-formula fuel-formula--small">n = [0, sin 105°, −cos 105°] <br />p<sub>link6</sub> = p<sub>tip</sub> + 0.63n <br />+ [0, 0, −0.25]</p>
        <table class="fuel-stage-table">
          <caption>현재 코드 설정 · center 기준 거리와 명령 속도</caption>
          <thead><tr><th scope="col">단계</th><th scope="col">거리</th><th scope="col">속도</th></tr></thead>
          <tbody>{stages.map(([stage, distance, speed]) => (
            <tr><th scope="row">{stage}</th><td>{distance}</td><td>{speed}</td></tr>
          ))}</tbody>
        </table>
        <p class="fuel-note">105°는 world YZ 평면의 방향각입니다. 노즐 offset은 코드 tuning 값이며, 실제 삽입 깊이나 TCP calibration 측정값은 아닙니다.</p>
      </div>
      <figure class="fuel-evidence">
        <div class="fuel-diagram-scroll" tabindex="0" role="region" aria-label="노즐과 손목 목표점 도해, 좁은 화면에서 좌우 스크롤">
          <img src={asset('approach-geometry.svg')} width="1200" height="1154" loading="lazy" decoding="async"
            alt="World YZ 평면의 105도 고정 접근축. Center 기준 far, mid, near, insert tip 목표와 가상 노즐 0.63 m, Z 마이너스 0.25 m를 더한 link_6 목표." />
        </div>
        <figcaption><span>코드 기반 도해 · tip과 link_6의 관계</span><a href={asset('approach-geometry.svg')} target="_blank" rel="noopener">도해 원본 보기 ↗</a></figcaption>
      </figure>
    </div>
    <div class="fuel-development">
      <div>
        <p class="fuel-label">Development / Two viewpoints</p>
        <h3>접근 전 → 접근 중 → 근접 자세</h3>
        <p>같은 동작을 전체 배치와 말단 근접 화면으로 확인한 초기 개발 기록입니다.</p>
        <p class="fuel-note">각 프레임을 현재 코드의 far / near / insert 단계나 거리 측정 결과로 대응한 자료는 아닙니다.</p>
      </div>
      <figure class="fuel-evidence">
        <a class="fuel-image-link" href={asset('approach-development-filmstrip.webp')} target="_blank" rel="noopener">
          <img src={asset('approach-development-filmstrip.webp')} width="1200" height="1454" loading="lazy" decoding="async"
            alt="위에서부터 접근 전 3초, 접근 중 7초, 근접 자세 13초. 각 행의 왼쪽은 전체 배치, 오른쪽은 말단 근접 화면." />
        </a>
        <figcaption><span>초기 접근 개발 · 원본 시간 순서</span><a href={asset('approach-development-filmstrip.webp')} target="_blank" rel="noopener">이미지 원본 보기 ↗</a></figcaption>
      </figure>
    </div>
  </section>

  <section class="fuel-section page-shell" id="motion" aria-labelledby="motion-title">
    <div class="fuel-section__header">
      <p class="fuel-label">05 / Motion generation</p>
      <div>
        <h2 id="motion-title">단계별 위치 명령을 보간하고 <br />RMPFlow로 실행하다</h2>
        <p>자체 waypoint 목록에서 매 60 Hz simulation step마다 speed × dt만큼 command target을 이동시켰습니다. RMPFlow는 이 위치와 고정 자세 목표를 추종할 관절 명령을 계산합니다.</p>
      </div>
    </div>
    <div class="fuel-motion-layout">
      <figure class="fuel-evidence">
        <ProjectVideo src={asset('waypoint-development.mp4')} poster={asset('waypoint-development-poster.webp')}
          width={946} height={522}
          label="초기 Isaac Sim 개발 화면에서 로봇 말단이 색상으로 표시한 목표점으로 움직이는 장면" />
        <figcaption><span>초기 waypoint 개발 · 목표점으로 접근</span><span>10초 · 무음 · 원본 재생 속도</span></figcaption>
      </figure>
      <div>
        <ol class="fuel-control-loop">
          <li><span>01</span><strong>Waypoint 목록</strong><small>Far → Mid → Near → Insert → Retreat</small></li>
          <li><span>02</span><strong>Cartesian command</strong><small>매 step에 speed × dt만큼 이동</small></li>
          <li><span>03</span><strong>RMPFlow → Joint action</strong><small>위치 + reset 시 저장한 EE 자세</small></li>
          <li><span>04</span><strong>다음 단계 판정</strong><small>도달 거리 · hold · timeout</small></li>
        </ol>
        <p class="fuel-note">경로는 lock 또는 기준 좌표 확정 뒤 한 번 생성합니다. 일반 위치 stage는 600 step timeout 뒤 다음 단계로 진행합니다.</p>
      </div>
    </div>
  </section>

  <section class="fuel-section page-shell" id="troubleshooting" aria-labelledby="troubleshooting-title">
    <div class="fuel-section__header">
      <p class="fuel-label">06 / Troubleshooting</p>
      <div>
        <h2 id="troubleshooting-title">위치 추종만으로는 <br />툴 방향이 유지되지 않았다</h2>
        <p>초기 위치 제어 시험에서는 목표점을 따라 이동하는 동안 EE 방향이 달라졌습니다. 목표 위치와 툴 자세를 별도로 지정할 필요가 있었습니다.</p>
      </div>
    </div>
    <figure class="fuel-evidence fuel-orientation">
      <a class="fuel-image-link" href={asset('orientation-development.webp')} target="_blank" rel="noopener">
        <img src={asset('orientation-development.webp')} width="1280" height="664" loading="lazy" decoding="async"
          alt="왼쪽은 초기 위치 제어 실험, 오른쪽은 고정 자세 waypoint 시험. 서로 다른 개발 scene의 로봇과 목표점." />
      </a>
      <figcaption><span>방향 제어 개발 기록 · 서로 다른 scene</span><a href={asset('orientation-development.webp')} target="_blank" rel="noopener">이미지 원본 보기 ↗</a></figcaption>
    </figure>
    <dl class="fuel-findings">
      <div><dt>분석</dt><dd>Position 목표만으로 tool orientation을 결정할 수 없었습니다.</dd></div>
      <div><dt>적용</dt><dd>현재 코드는 reset 시 EE quaternion을 저장하고, waypoint 실행 중 같은 자세 목표를 전달합니다.</dd></div>
      <div><dt>확인</dt><dd>코드와 개발 영상에서 자세 제약 적용을 확인했습니다. 자동 축 정렬이나 반복 삽입 성공률을 검증한 결과는 아닙니다.</dd></div>
    </dl>
  </section>

  <section class="fuel-result" id="results" aria-labelledby="result-title">
    <div class="page-shell fuel-result__inner">
      <p class="eyebrow">07 / Result · Simulation demonstration</p>
      <h2 id="result-title">두 로봇의 순차 작업을 <br />시뮬레이션으로 시연하다</h2>
      <p class="fuel-result__lead">팀은 마커 기준 목표점을 단계별 위치 명령과 RMPFlow에 연결하고, B의 cap 작업 → A의 노즐 동작 → B의 복원 순서를 구성했습니다.</p>
      <ol class="fuel-sequence" aria-label="두 로봇의 작업 순서">
        <li><span>01 / Robot B</span><strong>Door 준비 · Cap 제거</strong><small>/robot_b/done → A 시작</small></li>
        <li><span>02 / Robot A</span><strong>노즐 접근 · 삽입 · 후퇴</strong><small>/robot_a/done → B 복원</small></li>
        <li><span>03 / Robot B</span><strong>Cap 복원 · Door 닫기</strong><small>작업 후 home 복귀</small></li>
      </ol>
      <div class="fuel-result-grid">
