---
import { site } from '@/data/site';
import { withBase } from '@/utils/paths';

const currentPath = Astro.url.pathname;
const resumeHref = site.resumePath
  ? withBase(site.resumePath)
  : withBase('/about/#resume');

const navItems = [
  {
    label: 'Projects',
    href: withBase('/#projects'),
    active: currentPath === withBase('/') || currentPath.includes('/projects/'),
  },
  {
    label: 'About',
    href: withBase('/about/'),
    active: currentPath.includes('/about/'),
  },
  { label: 'Resume', href: resumeHref, active: currentPath.includes('/resume') },
];
---

<header class="site-header">
  <div class="site-header__inner page-shell">
    <a class="brand" href={withBase('/')} aria-label="Bae Cheolgyu 홈으로 이동">
      <span class="brand__name">{site.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="주요 메뉴">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href={site.githubUrl} rel="noreferrer" target="_blank">
        GitHub<span class="sr-only"> (새 창)</span>
      </a>
    </nav>

    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="모바일 메뉴">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <a href={site.githubUrl} rel="noreferrer" target="_blank">
          GitHub<span class="sr-only"> (새 창)</span>
        </a>
      </nav>
    </details>
  </div>
</header>
