---
interface Props {
  role: string;
  items?: string[];
}
const { role, items = [] } = Astro.props;
---

<aside class="project-contribution" aria-label="담당 역할">
  <p class="eyebrow">My contribution</p>
  {items.length ? <ul>{items.map(item => <li>{item}</li>)}</ul> : <p>{role}</p>}
</aside>

<style>
  .project-contribution { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 1.25rem; padding-top: 1rem; border-top: var(--rule); }
  .project-contribution > .eyebrow { padding-top: 0.2rem; }
  .project-contribution ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1.6rem; margin: 0; padding-left: 1rem; }
  .project-contribution li, .project-contribution > p:last-child { font-size: 0.88rem; line-height: 1.65; word-break: keep-all; overflow-wrap: anywhere; }
  .project-contribution li::marker { color: var(--rust); }
  @media (max-width: 760px) {
    .project-contribution { grid-template-columns: minmax(0, 1fr); gap: 0.65rem; }
    .project-contribution ul { display: grid; gap: 0.35rem; }
  }
</style>
