---
interface Props {
  role: string;
}
const { role } = Astro.props;
---

<aside class="project-contribution" aria-label="담당 역할">
  <p class="eyebrow">My contribution</p>
  <p>{role}</p>
</aside>

<style>
  .project-contribution {
    display: grid;
    grid-template-columns: minmax(150px, 0.25fr) minmax(0, 0.75fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: var(--rule);
  }
  .project-contribution > .eyebrow { grid-column: 1; }
  .project-contribution > p:last-child {
    grid-column: 2;
    max-width: 48rem;
    font-size: 1rem;
    line-height: 1.8;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  @media (max-width: 760px) {
    .project-contribution { grid-template-columns: 1fr; gap: 0.75rem; }
    .project-contribution > .eyebrow,
    .project-contribution > p:last-child { grid-column: 1; }
    .project-contribution > p:last-child { font-size: 0.94rem; }
  }
</style>
