---
import { site } from '@/data/site';
import { withBase } from '@/utils/paths';
---

<footer class="site-footer" id="contact">
  <div class="page-shell site-footer__inner">
    <div class="site-footer__identity">
      <p>{site.name}</p>
      <p>{site.role}</p>
    </div>
    <div class="site-footer__links" aria-label="연락처">
      <div>
        <span>Email</span>
        <a href={'mailto:' + site.email}>{site.email}</a>
      </div>
      <div>
        <span>GitHub</span>
        <a href={site.githubUrl} rel="noreferrer" target="_blank">
          CGBae<span class="sr-only"> (새 창)</span>
        </a>
      </div>
      <div>
        <span>Resume</span>
        <a href={withBase(site.resumePath)}>PDF 열기 ↗</a>
      </div>
    </div>
    <p class="site-footer__note">ROS2 · Perception · Robot Motion</p>
  </div>
</footer>
