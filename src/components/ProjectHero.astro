---
import type { Project } from '@/data/projects';
import ProjectContribution from '@/components/ProjectContribution.astro';
interface Props {
  project: Project;
  titleLines: string[];
  tagline: string;
  intro: string;
  contributions: string[];
  team: string;
  platform: string;
  repository: string;
  sections: { href: string; label: string }[];
}
const { project, titleLines, tagline, intro, contributions, team, platform, repository, sections } = Astro.props;
---
<section class="case-hero page-shell" id="demo" aria-labelledby="project-title">
  <header class="case-hero__header">
    <div>
      <p class="eyebrow">{project.number} / {project.category}</p>
      <h1 id="project-title">{titleLines.map(line => <span>{line}</span>)}</h1>
      <p class="case-hero__tagline">{tagline}</p>
      <p class="case-hero__intro">{intro}</p>
    </div>
    <div class="case-hero__context">
      <dl>
        <div><dt>Project period</dt><dd>{project.period}</dd></div>
        <div><dt>Team · Platform</dt><dd>{team}<br />{platform}</dd></div>
      </dl>
      <p class="case-hero__stack">{project.subtitle.join(' · ')}</p>
      <a class="text-link" href={repository} target="_blank" rel="noopener">프로젝트 GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (새 창)</span></a>
    </div>
  </header>
  <ProjectContribution role={project.role} items={contributions} />
  <nav class="case-nav" aria-label="핵심 구현 바로가기">
    {sections.map(({ href, label }) => <a href={href}>{label} <span aria-hidden="true">↓</span></a>)}
  </nav>
  <div class="case-hero__media"><slot /></div>
</section>
