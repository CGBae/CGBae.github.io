---
import type { Project } from '@/data/projects';
import { withBase } from '@/utils/paths';
import MediaFrame from './MediaFrame.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const titleId = 'project-' + project.slug + '-title';
const projectHref = withBase('/projects/' + project.slug + '/');
---

<article class="project-row" aria-labelledby={titleId}>
  <div class="project-row__copy">
    <p class="project-row__kicker">
      <span>Project</span>
      <span aria-hidden="true">{project.number}</span>
    </p>
    <h3 id={titleId}>
      <a href={projectHref}>{project.title}</a>
    </h3>
    <p class="project-row__stack">{project.subtitle.join(' · ')}</p>
    <p class="project-row__description">{project.description}</p>
    <a class="text-link" href={projectHref}>
      프로젝트 상세 보기 <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="project-row__media">
    <MediaFrame
      kind={project.asset.kind}
      src={project.asset.src}
      poster={project.asset.poster}
      alt={project.asset.alt}
      label={project.asset.label}
      direction={project.visualDirection}
      aspectRatio={project.asset.aspectRatio}
      variant={project.number}
      showIndex={false}
    />
  </div>
</article>
