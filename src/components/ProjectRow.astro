---
import type { Project } from '@/data/projects';
import { withBase } from '@/utils/paths';
import MediaFrame from './MediaFrame.astro';

interface Props {
  project: Project;
  reverse?: boolean;
}

const { project, reverse = false } = Astro.props;
---

<article class:list={['project-row', { 'project-row--reverse': reverse }]}> 
  <div class="project-row__number" aria-hidden="true">{project.number}</div>
  <div class="project-row__media">
    <MediaFrame
      kind={project.asset.kind}
      src={project.asset.src}
      poster={project.asset.poster}
      alt={project.asset.alt}
      label={project.asset.label}
      direction={project.visualDirection}
      aspectRatio={project.asset.aspectRatio}
      variant={project.number}
    />
  </div>
  <div class="project-row__copy">
    <p class="project-row__kicker">Project {project.number}</p>
    <h2>{project.title}</h2>
    <p class="project-row__stack">{project.subtitle.join(' · ')}</p>
    <p class="project-row__description">{project.description}</p>
    <a class="text-link" href={withBase(`/projects/${project.slug}/`)}>
      View project <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
